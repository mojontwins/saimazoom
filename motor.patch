diff --git a/dev/shots.h b/dev/shots.h
new file mode 100644
index 0000000..faf3d90
--- /dev/null
+++ b/dev/shots.h
@@ -0,0 +1,46 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Disparos (ENABLE_SHOTS), como los biberones de Ali Bebe: con KEY_BUTTON_A
+// se lanza uno en la direccion en la que miras (si quedan y no hay otro en
+// vuelo). Avanza SHOT_SPEED caracteres por vuelta y se para al chocar con un
+// obstaculo o salir del area. Si da al monstruo errante, lo quita de la
+// pantalla.
+//
+//   SHOTS_INI, SHOT_SPEED, SHOT_FRAME(dir), SHOTS_X, SHOTS_Y, SP_SHOT
+
+unsigned char shots, shot_on, shot_x, shot_y, shot_dir, shot_ct;
+
+void shots_hud (void) {
+	rda = shots; _x = SHOTS_X; _y = SHOTS_Y; print_2digits ();
+}
+
+void shots_init (void) {
+	shots = SHOTS_INI; shot_on = 0;
+	shots_hud ();
+}
+
+void shots_tick (void) {
+	if (shot_on) {
+		shot_ct = SHOT_SPEED;
+		while (shot_ct --) {
+			shot_x += dx [shot_dir]; shot_y += dy [shot_dir];
+			// Fuera del area o contra un obstaculo (miramos el tile de su centro)
+			if (shot_x > (ROOM_W - 1) * 3 || shot_y > (ROOM_H - 1) * 3 ||
+				(attr ((shot_x + 1) / 3, (shot_y + 1) / 3) & BEH_OBSTACLE)) {
+				shot_on = 0; return;
+			}
+			#ifdef ENABLE_WANDERER
+				if (estate > STATE_APPEARING && estate != STATE_KILLED &&
+					shot_x + 2 >= ex && shot_x <= ex + 2 && shot_y + 2 >= ey && shot_y <= ey + 2) {
+					estate = STATE_OFF; wanderer_off = 1; shot_on = 0;
+					return;
+				}
+			#endif
+		}
+	} else if (shots && cpc_TestKey (KEY_BUTTON_A)) {
+		shots --; shots_hud ();
+		shot_on = 1; shot_dir = pfacing >> 1;
+		shot_x = px; shot_y = py;
+	}
+}
