+	112, 8, 1,   113, 4, 2,   114, 5, 3,   115, 5, 2,   117, 1, 3,   116, 2, 2,
+	118, 4, 1,   118, 2, 3,   119, 2, 1,   127, 4, 2,   128, 5, 3,   129, 2, 1,
+	130, 7, 2,   131, 5, 3,   132, 6, 3,   133, 3, 3,   134, 8, 3
+};
+
+// Puertas con llave (BASIC 2060-2150): sala, x, y. Abierta, subiendo desde
+// la puerta se pasa a la pantalla de arriba; bajando de ella se aparece
+// en la puerta.
+#define DOOR_A_ROOM 51 		// Se abre con la llave A (sala 52 del original)
+#define DOOR_A_X 5
+#define DOOR_B_ROOM 15 		// Se abre con la llave B (sala 16 del original)
+#define DOOR_B_X 4
+#define DOOR_Y 1
+
+// Encargos
+#define PRISONER_ROOM 125 	// Sala 126: el prisionero en (fila 10, col 22)
+#define PRISONER_X 7
+#define PRISONER_Y 3
+#define PRINCESS_ROOM 5 	// Sala 6: el monstruo errante es la princesa
+#define TREASURE_ROOM 34 	// Sala 35: entrar es encontrar el tesoro
+
+// Iconos del marcador (celdas) (BASIC 720)
+#define HUD_ICON_Y 17
+#define HUD_PRINCESS_X 8
+#define HUD_PRISONER_X 11
+#define HUD_TREASURE_X 14
+#define HUD_SPELL_X 4 		// Letras del hechizo: fila 21, columnas 4 + 3n
+#define HUD_SPELL_Y 21
diff --git a/games/babaliba/game.h b/games/babaliba/game.h
new file mode 100644
index 0000000..1a51484
--- /dev/null
+++ b/games/babaliba/game.h
@@ -0,0 +1,143 @@
+// Babaliba CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Reglas propias de Babaliba (ganchos GAME_HOOKS del motor).
+//
+// Encargos (BASIC 160-200): rescatar al prisionero (sala 126), atrapar a la
+// princesa (sala 6, huye de ti) y encontrar el tesoro (sala 35). Con los
+// tres, se reparten las letras de BABALIBA, que hay que recoger en orden.
+// Con las 8, has ganado. Las dos llaves abren las puertas de las salas 16
+// y 52. Matar con una bomba a la princesa o al prisionero es fracasar.
+//
+// TODO: los mensajes del original ("UNA VIDA MENOS", "HAS RESCATADO AL
+// PRISIONERO"...) necesitan una fuente; de momento son pausas.
+
+unsigned char got_prisoner, got_princess, got_treasure, spell_phase, spell_n;
+unsigned char door_a_open, door_b_open;
+unsigned char prisoner_ct;
+
+void hud_icon (unsigned char x, unsigned char t) {
+	draw_cell_tile (x, HUD_ICON_Y, t);
+}
+
+void game_pause (void) {
+	// En el original, un mensaje y esperar a una tecla
+	wait_frames (50);
+}
+
+void game_init (void) {
+	got_prisoner = got_princess = got_treasure = spell_phase = spell_n = 0;
+	door_a_open = door_b_open = 0;
+
+	// Iconos del marcador y letras: huecos fijos del tileset dinamico
+	dyn_pin (MT_HUD_PRISONER); dyn_pin (MT_HUD_PRINCESS); dyn_pin (MT_TREASURE);
+	dyn_pin (MT_KEY_A); dyn_pin (MT_KEY_B);
+	dyn_pin (MT_LETTER_B); dyn_pin (MT_LETTER_A); dyn_pin (MT_LETTER_L); dyn_pin (MT_LETTER_I);
+
+	// Las llaves se reparten ya (BASIC 100: GO SUB 2160 con 8..9)
+	items_place (ITEM_KEY_A, ITEM_KEY_B);
+}
+
+void game_enter_room (void) {
+	// Puertas abiertas: el tile desaparece
+	_y = DOOR_Y;
+	if (n_pant == DOOR_A_ROOM && door_a_open) { _x = DOOR_A_X; clear_tile (); }
+	if (n_pant == DOOR_B_ROOM && door_b_open) { _x = DOOR_B_X; clear_tile (); }
+
+	// Bajando desde la pantalla de arriba por una puerta, apareces en ella
+	rda = 0;
+	if (n_pant == DOOR_A_ROOM && ptx == DOOR_A_X) rda = 1;
+	if (n_pant == DOOR_B_ROOM && ptx == DOOR_B_X) rda = 1;
+	if (pty == 0 && rda) {
+		pty = DOOR_Y; sync_coodinates ();
+		rsp_y = pty;
+	}
+
+	// La princesa hace de monstruo errante en su sala
+	wanderer_flee = 0;
+	if (n_pant == PRINCESS_ROOM && got_princess == 0) wanderer_flee = 1;
+
+	// El tesoro se encuentra al entrar en su sala (BASIC 170)
+	if (n_pant == TREASURE_ROOM && got_treasure == 0) {
+		got_treasure = 1;
+		hud_icon (HUD_TREASURE_X, MT_TREASURE);
+		game_pause ();
+	}
+
+	prisoner_ct = 0;
+}
+
+void prisoner_draw (unsigned char t) {
+	draw_tile (PRISONER_X, PRISONER_Y, t);
+	invalidate_tile (PRISONER_X, PRISONER_Y);
+}
+
+void game_tick (void) {
+	// Prisionero (BASIC 160, 640-650): se mueve; se le rescata al pasar por
+	// la columna 20 de la fila 10 (entrando en su casilla desde la izquierda)
+	if (n_pant == PRISONER_ROOM && got_prisoner == 0) {
+		if (px == 19 && py == 9) {
+			got_prisoner = 1;
+			prisoner_draw (0);
+			hud_icon (HUD_PRISONER_X, MT_HUD_PRISONER);
+			game_pause ();
+		} else if ((prisoner_ct ++ & 3) == 0) {
+			prisoner_draw (rand () < 120 ? MT_PRISONER_B : MT_PRISONER_A);
+		}
+	}
+
+	// Puertas: desde la puerta abierta, hacia arriba, a la pantalla de arriba
+	rda = 0;
+	if (n_pant == DOOR_A_ROOM && ptx == DOOR_A_X && door_a_open) rda = 1;
+	if (n_pant == DOOR_B_ROOM && ptx == DOOR_B_X && door_b_open) rda = 1;
+	if (rda && pstate != STATE_WALK && pdirection == DIRECTION_UP && pty == DOOR_Y) {
+		n_pant -= MAP_W;
+		pty = ROOM_H - 1; sync_coodinates ();
+		pdirection = 0xff;
+	}
+
+	// Con los tres encargos, a por el hechizo (BASIC 190, 870)
+	if (spell_phase == 0 && got_prisoner && got_princess && got_treasure) {
+		spell_phase = 1;
+		game_pause ();
+		items_place (0, 7);
+	}
+}
+
+// Has tocado a la princesa (BASIC 1230, 750)
+void game_wanderer_touch (void) {
+	got_princess = 1;
+	wanderer_flee = 0;
+	hud_icon (HUD_PRINCESS_X, MT_HUD_PRINCESS);
+	game_pause ();
+	wanderer_spawn (); 			// Ahora sale un monstruo de verdad
+}
+
+// Recoger el objeto item_i. Devuelve 0 si no se puede (letra fuera de orden)
+unsigned char game_item_pickup (void) {
+	if (item_i == ITEM_KEY_A) {
+		door_a_open = 1; hud_icon (HUD_PRINCESS_X, MT_KEY_A);
+	} else if (item_i == ITEM_KEY_B) {
+		door_b_open = 1; hud_icon (HUD_TREASURE_X, MT_KEY_B);
+	} else {
+		if (spell_n == 8 || item_mt [item_i] != spell [spell_n]) return 0;
+		draw_cell_tile (HUD_SPELL_X + (spell_n << 1) + spell_n, HUD_SPELL_Y, spell [spell_n]);
+		spell_n ++;
+	}
+	return 1;
+}
+
+// La bomba ha explotado en bomb_room (BASIC 570-580)
+void game_bomb_exploded (void) {
+	if ((bomb_room == PRINCESS_ROOM && got_princess == 0) ||
+		(bomb_room == PRISONER_ROOM && got_prisoner == 0)) {
+		game_result = RESULT_FAIL; playing = 0;
+	}
+}
+
+// BASIC 200: con las ocho letras, has ganado
+void check_win (void) {
+	if (spell_n == 8) {
+		game_result = RESULT_WIN; playing = 0;
+	}
+}
