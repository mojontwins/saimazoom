diff --git a/dev/bombs.h b/dev/bombs.h
new file mode 100644
index 0000000..4a14b97
--- /dev/null
+++ b/dev/bombs.h
@@ -0,0 +1,66 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Bombas (ENABLE_BOMBS), como en Babaliba (BASIC 500-600):
+// - Con KEY_BUTTON_A (espacio) se deja una bomba donde estas, si no hay otra.
+// - A los BOMB_FUSE ticks explota. Si sigues en esa pantalla pierdes una vida.
+// - Los enemigos de esa pantalla desaparecen durante BOMB_CLEAR_TICKS ticks.
+// - game_bomb_exploded () (GAME_HOOKS) decide si la explosion tiene otras
+//   consecuencias (en Babaliba, matar a la princesa o al prisionero).
+//
+//   BOMBS_INI, BOMB_FUSE, BOMB_CLEAR_TICKS, BOMBS_X, BOMBS_Y, MT_BOMB
+
+unsigned char bombs, bomb_ct, bomb_room, bomb_x, bomb_y;
+unsigned char enemies_off_room, enemies_off_ct;
+
+void bombs_hud (void) {
+	rda = bombs; _x = BOMBS_X; _y = BOMBS_Y; print_2digits ();
+}
+
+void bombs_init (void) {
+	bombs = BOMBS_INI; bomb_ct = 0; enemies_off_ct = 0;
+	bombs_hud ();
+}
+
+void bomb_draw (void) {
+	draw_tile (bomb_x, bomb_y, MT_BOMB);
+	invalidate_tile (bomb_x, bomb_y);
+}
+
+void bomb_enter_room (void) {
+	if (bomb_ct && bomb_room == n_pant) bomb_draw ();
+}
+
+void bomb_explode (void) {
+	// Fogonazo
+	cpc_Border (0x4B); wait_frames (3); cpc_Border (BORDER_COLOUR);
+
+	enemies_off_room = bomb_room; enemies_off_ct = BOMB_CLEAR_TICKS;
+
+	if (bomb_room == n_pant) {
+		// Quitamos la bomba del mapa
+		_x = bomb_x; _y = bomb_y;
+		draw_tile (_x, _y, map_tile_at ());
+		invalidate_tile (bomb_x, bomb_y);
+	}
+
+	#ifdef GAME_HOOKS
+		game_bomb_exploded ();
+		if (playing == 0) return;
+	#endif
+
+	if (bomb_room == n_pant) lose_life ();
+}
+
+void bombs_tick (void) {
+	if (enemies_off_ct) enemies_off_ct --;
+
+	if (bomb_ct) {
+		if (-- bomb_ct == 0) bomb_explode ();
+	} else if (bombs && cpc_TestKey (KEY_BUTTON_A)) {
+		bombs --; bombs_hud ();
+		bomb_room = n_pant; bomb_x = ptx; bomb_y = pty;
+		bomb_ct = BOMB_FUSE;
+		bomb_draw ();
+	}
+}
