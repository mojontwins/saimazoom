diff --git a/dev/teleports.h b/dev/teleports.h
new file mode 100644
index 0000000..e53a0d2
--- /dev/null
+++ b/dev/teleports.h
@@ -0,0 +1,29 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Pantallas que te llevan a otra nada mas entrar (ENABLE_ROOM_TELEPORTS),
+// como los agujeros de Babaliba (BASIC 1680, 1750, 2030).
+//
+// data.h define N_TELEPORTS y teleports [] = sala, destino, x, y (tiles).
+// Al llegar, el monstruo errante no aparece en esa pantalla.
+
+void room_teleport (void) {
+	#ifdef ENABLE_WANDERER
+		wanderer_off = 0;
+	#endif
+	gp_gen = teleports;
+	for (gpit = 0; gpit < N_TELEPORTS; gpit ++) {
+		if (gp_gen [0] == n_pant) {
+			// Un fogonazo en lugar de la animacion del original
+			cpc_Border (0x4B); wait_frames (10); cpc_Border (BORDER_COLOUR);
+			n_pant = gp_gen [1];
+			ptx = gp_gen [2]; pty = gp_gen [3];
+			pfacing = DIRECTION_DOWN << 1;
+			#ifdef ENABLE_WANDERER
+				wanderer_off = 1;
+			#endif
+			return;
+		}
+		gp_gen += 4;
+	}
+}
diff --git a/dev/tiles_dyn.h b/dev/tiles_dyn.h
new file mode 100644
index 0000000..eba6fcb
--- /dev/null
+++ b/dev/tiles_dyn.h
@@ -0,0 +1,138 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Tileset dinamico (TILESET_DYNAMIC).
+//
+// Para juegos con mas patrones de los que caben en el nametable (256), como
+// Babaliba, cuyos metatiles son el mismo grafico con distintos colores.
+//
+// - Los graficos base (9 patrones de 4x8, 144 bytes) estan comprimidos con
+//   zx0 cada uno por separado (ts_base_data + ts_base_offs [base]).
+// - Un metatile de mapa = grafico base + tabla de recoloreo de 16 pens
+//   (mt_base [], mt_remap [] -> mt_remaps + 16 * n, 0xff = sin recoloreo).
+// - El tileset es: digitos (0-9), vacio (10) y DYN_SLOTS huecos de 9 patrones.
+// - Al pintar un metatile se busca su hueco; si no tiene, se descomprime y se
+//   recolorea en el siguiente libre. Al cambiar de pantalla se liberan todos
+//   menos los "fijos" (dyn_pin), que son los que usa el marcador.
+
+#define DYN_EMPTY 		10
+#define DYN_FIRST 		11
+#define DYN_PL 			0xEE00 		// pen del pixel izquierdo de cada byte (256)
+#define DYN_PR 			0xEF00 		// pen del pixel derecho (256)
+#define DYN_REMAP 		0xF600 		// tabla de recoloreo en uso (16)
+#define DYN_EL 			0xF610 		// byte con el pixel izquierdo = pen (16)
+#define DYN_ER 			0xF620 		// byte con el pixel derecho = pen (16)
+#define DYN_BUF 		0xF640 		// buffer de descompresion (144)
+
+unsigned char dyn_slot [N_METATILES];
+unsigned char dyn_next, dyn_pinned;
+unsigned char *dyn_ptr;
+unsigned char dyn_s, dyn_r, dyn_t;
+
+// Patron mode 0: pixel 0 en bits 7,3,5,1 (bit0..3 del pen); pixel 1 en 6,2,4,0
+void dyn_init (void) {
+	gp_gen = (unsigned char *) DYN_PL;
+	// (ojo: "while (++ rda)" no sirve, sccz80 lo evalua en 16 bits)
+	for (gpint = 0; gpint < 256; gpint ++) {
+		rda = gpint;
+		gp_gen [0] = ((rda >> 7) & 1) | ((rda >> 2) & 2) | ((rda >> 3) & 4) | ((rda << 2) & 8);
+		gp_gen [256] = ((rda >> 6) & 1) | ((rda >> 1) & 2) | ((rda >> 2) & 4) | ((rda << 3) & 8);
+		gp_gen ++;
+	}
+	gp_gen = (unsigned char *) DYN_EL;
+	for (rda = 0; rda < 16; rda ++) {
+		gp_gen [rda] = ((rda & 1) << 7) | ((rda & 2) << 2) | ((rda & 4) << 3) | ((rda & 8) >> 2);
+		gp_gen [rda + 16] = ((rda & 1) << 6) | ((rda & 2) << 1) | ((rda & 4) << 2) | ((rda & 8) >> 3);
+	}
+	for (rda = 0; rda < N_METATILES; rda ++) dyn_slot [rda] = 0xff;
+	dyn_pinned = dyn_next = 0;
+}
+
+// Al cambiar de pantalla: libera los huecos no fijos
+void dyn_reset (void) {
+	for (rda = 0; rda < N_METATILES; rda ++) {
+		if (dyn_slot [rda] != 0xff && dyn_slot [rda] >= dyn_pinned) dyn_slot [rda] = 0xff;
+	}
+	dyn_next = dyn_pinned;
+}
+
+// Recolorea DYN_BUF (144 bytes) en dyn_ptr usando DYN_REMAP
+void dyn_recolour (void) {
+	#asm
+			ld  hl, DYN_BUF
+			ld  de, (_dyn_ptr)
+			ld  ixl, 144
+		.dyn_rc_loop
+			ld  a, (hl)
+			inc hl
+			push hl
+
+			ld  l, a
+			ld  h, 0xEE 				// DYN_PL
+			ld  c, (hl) 			// pen izquierdo
+			inc h
+			ld  l, (hl) 			// pen derecho
+			ld  h, 0xF6 				// DYN_REMAP
+			ld  a, (hl) 			// recoloreado
+			add 0x20 				// DYN_ER
+			ld  l, a
+			ld  b, (hl) 			// byte con el pixel derecho
+
+			ld  l, c
+			ld  a, (hl) 			// izquierdo recoloreado
+			add 0x10 				// DYN_EL
+			ld  l, a
+			ld  a, (hl)
+			or  b
+			ld  (de), a
+			inc de
+
+			pop hl
+			dec ixl
+			jr  nz, dyn_rc_loop
+	#endasm
+}
+
+// Devuelve el primer patron del metatile dyn_t (cargandolo si hace falta)
+// (sccz80 no respeta __FASTCALL__ en funciones escritas en C: va por global)
+unsigned char dyn_get (void) {
+	if (dyn_t == 0) return DYN_EMPTY;
+	if ((dyn_s = dyn_slot [dyn_t]) == 0xff) {
+		dyn_s = dyn_next;
+		if (dyn_next < DYN_SLOTS - 1) dyn_next ++;
+		dyn_slot [dyn_t] = dyn_s;
+
+		dyn_ptr = tileset + ((DYN_FIRST * 16) + (dyn_s * 144));
+		gp_gen = ts_base_data + ts_base_offs [mt_base [dyn_t]];
+
+		if ((dyn_r = mt_remap [dyn_t]) == 0xff) {
+			#asm
+					ld  hl, (_gp_gen)
+					ld  de, (_dyn_ptr)
+					call dzx0_standard
+			#endasm
+		} else {
+			#asm
+					ld  hl, (_gp_gen)
+					ld  de, DYN_BUF
+					call dzx0_standard
+			#endasm
+			gp_gen = mt_remaps + (dyn_r << 4);
+			#asm
+					ld  hl, (_gp_gen)
+					ld  de, DYN_REMAP
+					ld  bc, 16
+					ldir
+			#endasm
+			dyn_recolour ();
+		}
+	}
+	return DYN_FIRST + (dyn_s << 3) + dyn_s;
+}
+
+// Carga un metatile en un hueco que no se libera al cambiar de pantalla.
+// Hay que llamarlo antes de pintar ninguna pantalla.
+void dyn_pin (unsigned char t) {
+	dyn_t = t; dyn_get ();
+	dyn_pinned = dyn_next;
+}
diff --git a/dev/wanderer.h b/dev/wanderer.h
new file mode 100644
index 0000000..aae4a1c
--- /dev/null
+++ b/dev/wanderer.h
@@ -0,0 +1,185 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Monstruo errante (ENABLE_WANDERER): uno por pantalla, aparece al azar y
+// persigue al jugador.
+//
+//   WANDERER_SPAWN_CHANCE n   Saimazoom: con el monstruo apagado, aparece si rand () < n
+//   WANDERER_SPAWN_ON_ENTER   Babaliba: aparece al entrar en la pantalla, lejos del jugador
+//   WANDERER_APPEAR_TICKS n   Ticks de animacion al aparecer (WANDERER_PUFF_FRAME)
+//   WANDERER_EVERY n          Se mueve una vuelta de cada n (Babaliba: 2)
+//   WANDERER_FRAME(k)         Frame del tipo k
+//   WANDERER_KINDS n          Babaliba: tipo = rand () % n
+//   WANDERER_BLOCK_MASK       Bits de comportamiento que no puede pisar
+//   WANDERER_AI_SAIMAZOOM     30% persigue (primero en vertical), 34% al azar, 36% quieto
+//   WANDERER_AI_BABALIBA      va hacia tu columna, en vertical se aleja (sic), 50% al azar
+//   WANDERER_PISTOL           Si te toca y llevas OBJ_PISTOL, muere el
+//   GAME_HOOKS                wanderer_flee = 1 lo convierte en algo que huye y
+//                             que al tocarlo llama a game_wanderer_touch ()
+
+unsigned char wanderer_off; 		// No aparece en esta pantalla
+unsigned char wanderer_flee; 		// Huye del jugador (Babaliba: la princesa)
+unsigned char wanderer_ct;
+
+#ifdef ENABLE_BOMBS
+	#define WANDERER_ACTIVE (enemies_off_ct == 0 || enemies_off_room != n_pant)
+#else
+	#define WANDERER_ACTIVE 1
+#endif
+
+#ifdef WANDERER_SPAWN_ON_ENTER
+	// Babaliba (BASIC 1150): casilla libre a 3 tiles o mas del jugador
+	void wanderer_spawn (void) {
+		estate = STATE_OFF;
+		if (wanderer_off) return;
+		eattempts = 32; while (eattempts --) {
+			etx = rand () % ROOM_W; ety = rand () % ROOM_H;
+			if (eattr (etx, ety)) continue;
+			rda = etx > ptx ? etx - ptx : ptx - etx;
+			rdb = ety > pty ? ety - pty : pty - ety;
+			if (rda < 3 && rdb < 3) continue;
+
+			ex = (etx << 1) + etx; ey = (ety << 1) + ety;
+			estate = STATE_IDLE; ect = 0; estep = 0;
+			edirection = rand () & 3;
+			#ifdef GAME_HOOKS
+				if (wanderer_flee) { etype = WANDERER_FLEE_FRAME; return; }
+			#endif
+			etype = WANDERER_FRAME (rand () % WANDERER_KINDS);
+			return;
+		}
+	}
+#endif
+
+void move_malote (void) {
+	if (!WANDERER_ACTIVE) return;
+
+	#ifdef WANDERER_EVERY
+		if (++ wanderer_ct < WANDERER_EVERY) return;
+		wanderer_ct = 0;
+	#endif
+
+	switch (estate) {
+		case STATE_OFF:
+			#ifdef WANDERER_SPAWN_CHANCE
+			// Make appear? Original: RND < 1000 (3%) por tick (BASIC 130)
+			if (rand () < WANDERER_SPAWN_CHANCE) {
+				eattempts = 3;
+
+				// Select somewhere
+				while (eattempts --) {
+					etx = rand () & 7;
+					ety = rand () & 7;
+
+					if (eattr (etx, ety) == 0) {
+						estate = STATE_APPEARING;
+						break;
+					}
+				}
+
+				if (estate == STATE_APPEARING) {
+					ex = (etx << 1) + etx;
+					ey = (ety << 1) + ety;
+					ect = WANDERER_APPEAR_TICKS; estep = 0; 	// 8 ticks de aparicion, como el original (BASIC 870)
+					etype = WANDERER_PUFF_FRAME; 	// Sprite ID of "puff"
+				}
+			}
+			#endif
+			break;
+
+		case STATE_APPEARING:
+		case STATE_KILLED:
+			if (ect --) {
+				estep ^= 1;
+			} else if (estate == STATE_APPEARING) {
+				#ifdef WANDERER_KINDS_SAIMAZOOM
+					etype = rand () & 7; if (etype > 4) etype -= 4;
+					etype = WANDERER_FRAME (etype);
+				#else
+					etype = WANDERER_FRAME (rand () % WANDERER_KINDS);
+				#endif
+				estate = STATE_IDLE;
+			} else estate = STATE_OFF;
+			break;
+
+		case STATE_WALK:
+			// Walk
+			ex += emx; ey += emy;
+
+			ect ++; if (ect == 3) {
+				estate = STATE_IDLE;
+			}
+
+			estep ^= 1;
+			break;
+
+		default:
+			#ifdef WANDERER_AI_SAIMAZOOM
+				// BASIC 450-510: 30% va hacia el jugador (primero en vertical),
+				// 34% elige direccion al azar, 36% se queda quieto.
+				rda = rand ();
+				if (rda < 78) {
+					if (pty < ety) rda = DIRECTION_UP;
+					else if (pty > ety) rda = DIRECTION_DOWN;
+					else if (ptx > etx) rda = DIRECTION_RIGHT;
+					else if (ptx < etx) rda = DIRECTION_LEFT;
+					else rda = 0xff;
+				} else if (rand () < 125) {
+					rda = rand () & 3;
+				} else rda = 0xff;
+			#endif
+
+			#ifdef WANDERER_AI_BABALIBA
+				// BASIC 930-990. Ojo: en vertical el original se ALEJA del
+				// jugador (compara al reves); en horizontal se acerca.
+				rda = edirection;
+				if (rand () < 128) {
+					if (pty < ety) rda = DIRECTION_DOWN;
+					else if (pty > ety) rda = DIRECTION_UP;
+				}
+				if (ptx > etx) rda = DIRECTION_RIGHT;
+				else if (ptx < etx) rda = DIRECTION_LEFT;
+				if (rand () < 125) rda = rand () & 3;
+				if (wanderer_flee) rda ^= 2;
+				edirection = rda;
+			#endif
+
+			if (rda != 0xff) {
+				emx = dx [rda]; emy = dy [rda];
+
+				// Can move?
+				if ((eattr (etx + emx, ety + emy) & WANDERER_BLOCK_MASK) == 0) {
+					etx += emx; ety += emy;
+					estate = STATE_WALK;
+					ect = 0;
+				}
+			}
+
+			#ifdef WANDERER_AI_SAIMAZOOM
+				estep = rand () & 1;
+			#endif
+	}
+}
+
+// Devuelve 1 si se ha perdido una vida (hay que saltarse el resto de la vuelta)
+unsigned char wanderer_collide (void) {
+	if (estate > STATE_APPEARING && estate != STATE_KILLED && WANDERER_ACTIVE) {
+		if (px + 2 >= ex && px <= ex + 2 && py + 2 >= ey && py <= ey + 2) {
+			#ifdef GAME_HOOKS
+				if (wanderer_flee) { game_wanderer_touch (); return 0; }
+			#endif
+			#ifdef WANDERER_PISTOL
+				if ((rdb = has_object (OBJ_PISTOL)) != 0xff) {
+					inventory_remove (rdb); SCORE_ADD (100);
+					estate = STATE_KILLED;
+					ect = 5; etype = WANDERER_PUFF_FRAME; 	// 400 ms, como antes a 25 fps
+					return 0;
+				}
+			#endif
+			// Saimazoom BASIC 930 -> 270 / Babaliba BASIC 1240: pierde una vida
+			lose_life ();
+			return 1;
+		}
+	}
+	return 0;
+}
