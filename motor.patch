--- /dev/null
+++ b/utils/zx2cpc/zxlib.py
@@ -0,0 +1,105 @@
+# zxlib.py - utilidades para extraer graficos de snapshots de Spectrum
+# y convertirlos a modo 0 de CPC (media resolucion horizontal).
+# Copyleft 2023 by The Mojon Twins
+
+import struct
+from PIL import Image
+
+# Paleta de trabajo para juegos convertidos de Spectrum:
+# pen 0 negro, 1-7 colores ZX sin brillo, 8-14 con brillo, 15 libre (naranja).
+ZX_TO_RGB = [(0,0,0),(0,0,128),(128,0,0),(128,0,128),(0,128,0),(0,128,128),(128,128,0),(128,128,128)]
+ZX_TO_RGB_BRIGHT = [(0,0,0),(0,0,255),(255,0,0),(255,0,255),(0,255,0),(0,255,255),(255,255,0),(255,255,255)]
+
+PALETTE = [(0,0,0)] + ZX_TO_RGB [1:] + ZX_TO_RGB_BRIGHT [1:] + [(255,128,0)]
+
+def zx_pen (colour, bright):
+	if colour == 0: return 0
+	return colour + (7 if bright else 0)
+
+def attr_pens (a):
+	br = 1 if a & 64 else 0
+	return zx_pen (a & 7, br), zx_pen ((a >> 3) & 7, br)
+
+def unz80 (fn):
+	# Devuelve la RAM (48K) de un .z80 como bytearray de 64K (ROM a ceros)
+	d = open (fn, "rb").read ()
+	def dec (b, size = None):
+		o = bytearray (); i = 0
+		while i < len (b):
+			if b [i:i+4] == b'\x00\xed\xed\x00': break
+			if b [i] == 0xed and i + 1 < len (b) and b [i+1] == 0xed:
+				o += bytes ([b [i+3]]) * b [i+2]; i += 4
+			else:
+				o.append (b [i]); i += 1
+			if size and len (o) >= size: break
+		return o
+	pc = struct.unpack ('<H', d [6:8]) [0]
+	mem = bytearray (65536)
+	if pc == 0:
+		l = struct.unpack ('<H', d [30:32]) [0]
+		i = 32 + l
+		while i < len (d):
+			bl, pg = struct.unpack ('<HB', d [i:i+3]); i += 3
+			raw = d [i:i+16384] if bl == 0xffff else d [i:i+bl]
+			i += 16384 if bl == 0xffff else bl
+			data = raw if bl == 0xffff else dec (raw, 16384)
+			addr = {4: 0x8000, 5: 0xc000, 8: 0x4000}.get (pg)
+			if addr: mem [addr:addr+16384] = data
+	else:
+		body = d [30:]
+		data = dec (body) if d [12] & 0x20 else body
+		mem [16384:16384+len (data)] = data [:49152]
+	return mem
+
+def half_char (mem, addr, ink, paper):
+	# Un caracter ZX (8x8) a 4x8 pens: cada pixel CPC = OR de dos pixels ZX
+	rows = []
+	for l in range (8):
+		b = mem [addr + l]
+		rows.append ([ink if (b >> (6 - 2 * k)) & 3 else paper for k in range (4)])
+	return rows
+
+def block (mem, addr, attrs, w = 3, h = 3, transparent_paper = False):
+	# Bloque de w x h caracteres (como los UDG de 3x3) -> matriz de pens (w*4 x h*8)
+	out = [[0] * (w * 4) for _ in range (h * 8)]
+	for c in range (w * h):
+		cx, cy = c % w, c // w
+		ink, paper = attr_pens (attrs [c])
+		if transparent_paper: paper = 0
+		ch = half_char (mem, addr + c * 8, ink, paper)
+		for y in range (8):
+			for x in range (4):
+				out [cy * 8 + y][cx * 4 + x] = ch [y][x]
+	return out
+
+def screen_pens (mem, base = 0x4000):
+	# Pantalla ZX completa a 128x192 pens
+	out = [[0] * 128 for _ in range (192)]
+	for y in range (192):
+		for xb in range (32):
+			a = base + (((y & 0xC0) << 5) | ((y & 7) << 8) | ((y & 0x38) << 2) | xb)
+			at = mem [base + 0x1800 + (y >> 3) * 32 + xb]
+			ink, paper = attr_pens (at)
+			b = mem [a]
+			for k in range (4):
+				out [y][xb * 4 + k] = ink if (b >> (6 - 2 * k)) & 3 else paper
+	return out
+
+def new_image (w, h):
+	return Image.new ("RGB", (w, h), (0, 0, 0))
+
+CURRENT = list (PALETTE)
+
+def set_palette (pal):
+	CURRENT [:] = pal
+
+def paste_pens (img, pens, x0, y0):
+	px = img.load ()
+	for y, row in enumerate (pens):
+		for x, p in enumerate (row):
+			px [x0 + x, y0 + y] = CURRENT [p]
+
+def palette_png (fn, pal = None):
+	img = new_image (16, 1)
+	for i, c in enumerate (pal or CURRENT): img.putpixel ((i, 0), c)
+	img.save (fn)
