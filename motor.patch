+// Datos propios de Ali Bebe (tablas del original, en codigo maquina sobre el
+// BASIC de Babaliba). Salas desde 0; posiciones en tiles:
+// x = (col - 1) / 3, y = (fila - 5) / 3.
+
+// Objetos: 0 pedestal, 1-3 llaves, 4-6 los tesoros (descriptores de 6536)
+unsigned char obj_mt [] = { MT_OBJ_0, MT_OBJ_1, MT_OBJ_2, MT_OBJ_3, MT_OBJ_4, MT_OBJ_5, MT_OBJ_6 };
+
+// Objetos en el suelo (63CE + 652D): objeto, sala, x, y. 0xff = lo llevas.
+// 0-2: los tesoros; 3-5: los pedestales; 6-8: las llaves (se reparten).
+#define N_ENTRIES 9
+unsigned char ent_ini [] = {
+	4, 14, 4, 1,
+	5, 35, 7, 2,
+	6, 105, 2, 2,
+	0, 102, 7, 2,
+	0, 117, 7, 2,
+	0, 132, 7, 2,
+	1, 0xff, 0, 0,
+	2, 0xff, 0, 0,
+	3, 0xff, 0, 0
+};
+
+// Gana con el tesoro i (entrada i) en la sala win_rooms [i] (63CE/63D1/63D4)
+unsigned char win_rooms [] = { 102, 117, 132 };
+
+// Sitios para las llaves (27125, se eligen 3 distintos): sala, x, y
+#define N_KEY_LOCS 12
+unsigned char key_locs [] = {
+	22, 5, 0,   74, 4, 3,   81, 9, 4,   68, 2, 0,   115, 8, 0,   45, 1, 2,
+	90, 2, 3,   9, 7, 1,   120, 2, 2,   95, 8, 1,   63, 4, 2,   118, 7, 2
+};
+
+// Pasos cerrados (E22C-E254): con la llave n entras en la sala y se abre la
+// casilla x, y (en el original se parchea el mapa). Llave 1, 2, 3.
+unsigned char gate_room [] = { 34, 44, 106 };
+unsigned char gate_x [] = { 9, 4, 0 };
+unsigned char gate_y [] = { 2, 1, 2 };
+
+// Teletransportes al entrar por una casilla (6892): sala, x, y -> sala, x, y
+#define N_POS_TELEPORTS 6
+unsigned char pos_teleports [] = {
+	85, 0, 2,    20, 9, 3,
+	68, 5, 4,    122, 5, 0,
+	113, 4, 0,   57, 7, 4,
+	21, 0, 3,    84, 9, 2,
+	107, 5, 4,   83, 5, 0,
+	72, 7, 0,    98, 4, 4
+};
+
+// Agujeros (6A40): a uno de estos 16 sitios al azar; con un tesoro en la
+// mano, siempre al ultimo (6A70)
+unsigned char holes [] = {
+	43, 7, 1,   47, 6, 2,   60, 4, 2,   60, 4, 2,   77, 2, 3,   121, 8, 1,
+	41, 2, 1,   83, 3, 2,   53, 2, 0,   36, 5, 2,   56, 7, 2,   112, 0, 1,
+	116, 1, 2,  82, 8, 0,   64, 5, 2,   17, 7, 4,
+	119, 8, 2
+};
+
+#define HUD_HAND_X 1
+#define HUD_HAND_Y 1
diff --git a/games/alibebe/game.h b/games/alibebe/game.h
index df626c3..62b0f72 100644
--- a/games/alibebe/game.h
+++ b/games/alibebe/game.h
@@ -1,18 +1,157 @@
 // Ali Bebe CPC
 // Copyleft 2023 by The Mojon Twins
 
-// Reglas propias de Ali Bebe - PENDIENTE (fase 2).
+// Reglas propias de Ali Bebe. En el Spectrum casi todo esta en parches de
+// codigo maquina sobre el BASIC compilado de Babaliba (las direcciones son
+// las del original):
 //
-// Lo que hace el original y aun no esta portado (en el Spectrum casi todo
-// esta en parches de codigo maquina sobre el BASIC compilado de Babaliba):
+// - Llevas un objeto en la mano (652C). Al chocar con un objeto del suelo lo
+//   coges y dejas en su sitio el que llevabas (DACC, C9C2, C9D6). Los
+//   pedestales son el "objeto 0": al dejar un tesoro en uno, el pedestal se
+//   va a la mano (invisible) y vuelve cuando recoges el tesoro.
+// - Las llaves 1, 2 y 3 abren el paso de las salas 35, 45 y 107 al entrar en
+//   ellas con la llave en la mano; la llave se gasta (E202-E254).
+// - Algunas casillas de entrada te llevan a otra sala (E176).
+// - Los agujeros (atributo 13) te mandan a un sitio al azar; con un tesoro
+//   en la mano, siempre al mismo (D27C).
+// - Ganas con los tres tesoros en las salas 103, 118 y 133 ("YA ERA HORA").
 //
-// - Objetos que se llevan de uno en uno (65 2C) y se cambian por los que hay
-//   en el suelo; usar el objeto 1/2/3 en las salas 35/45/107 abre el paso
-//   (BASIC 2090-2180, animaciones en CAA3-CAD5).
-// - Teletransportes al pisar ciertas casillas (tabla de E176: sala, fila,
-//   columna -> sala, fila, columna) y agujeros (atributo 13, BASIC 1340)
-//   que te llevan a un sitio al azar de una lista.
-// - Fin: el original comprueba en 63CE/63D1/63D4 que los tres encargos estan
-//   hechos ("YA ERA HORA").
-// - Los biberones dejan al monstruo fuera durante un rato en esa sala
-//   (BASIC 940), aqui simplemente no vuelve a salir en esa pantalla.
+// TODO: las animaciones al abrir un paso y los mensajes son fogonazos.
+
+unsigned char ent [N_ENTRIES * 4];
+unsigned char hand, gates_open, bump_ok;
+
+void hud_hand (void) {
+	draw_cell_tile (HUD_HAND_X, HUD_HAND_Y, obj_mt [hand]);
+}
+
+void ent_draw (void) {
+	// gp_gen apunta a la entrada
+	_x = gp_gen [2]; _y = gp_gen [3];
+	draw_tile (_x, _y, obj_mt [gp_gen [0]]);
+	set_attr (BEH_OBSTACLE | BEH_OBJECT);
+	invalidate_tile (_x, _y);
+}
+
+void flash (void) {
+	cpc_Border (0x4B); wait_frames (6); cpc_Border (BORDER_COLOUR);
+}
+
+void game_init (void) {
+	for (gpit = 0; gpit < N_ENTRIES * 4; gpit ++) ent [gpit] = ent_ini [gpit];
+
+	// Las llaves en tres sitios distintos (BASIC 2230-2270)
+	for (rda = 6; rda < 9; rda ++) {
+		while (1) {
+			rdb = rand () % N_KEY_LOCS;
+			gp_gen = key_locs + (rdb << 1) + rdb;
+			for (rdc = 6; rdc < rda; rdc ++) if (ent [(rdc << 2) + 1] == gp_gen [0]) break;
+			if (rdc == rda) break;
+		}
+		ent [(rda << 2) + 1] = gp_gen [0];
+		ent [(rda << 2) + 2] = gp_gen [1];
+		ent [(rda << 2) + 3] = gp_gen [2];
+	}
+
+	hand = 0; gates_open = 0; bump_ok = 1;
+	for (rda = 0; rda < 7; rda ++) dyn_pin (obj_mt [rda]);
+	hud_hand ();
+}
+
+void game_pre_enter_room (void) {
+	gp_gen = pos_teleports;
+	for (rda = 0; rda < N_POS_TELEPORTS; rda ++) {
+		if (gp_gen [0] == n_pant && gp_gen [1] == ptx && gp_gen [2] == pty) {
+			flash ();
+			n_pant = gp_gen [3]; ptx = gp_gen [4]; pty = gp_gen [5];
+			return;
+		}
+		gp_gen += 6;
+	}
+}
+
+void game_enter_room (void) {
+	// Usar una llave al entrar en su sala
+	for (rda = 0; rda < 3; rda ++) {
+		if (n_pant == gate_room [rda] && hand == rda + 1) {
+			gates_open |= (1 << rda);
+			hand = 0; hud_hand ();
+			flash ();
+		}
+		if (n_pant == gate_room [rda] && (gates_open & (1 << rda))) {
+			_x = gate_x [rda]; _y = gate_y [rda]; clear_tile ();
+		}
+	}
+
+	// Objetos en el suelo
+	gp_gen = ent;
+	for (rda = 0; rda < N_ENTRIES; rda ++) {
+		if (gp_gen [1] == n_pant) ent_draw ();
+		gp_gen += 4;
+	}
+}
+
+// Chocar con la casilla (_x, _y)
+void game_bump (void) {
+	if (bump_ok == 0) return;
+	// Como el original (D17B): vale cualquier choque con un objeto a un
+	// tile o menos (tambien en diagonal o debajo del jugador)
+	rdm = 0xff;
+	for (rda = 0; rda < N_ENTRIES; rda ++) {
+		gp_gen = ent + (rda << 2);
+		if (gp_gen [1] == n_pant &&
+			gp_gen [2] + 1 >= ptx && gp_gen [2] <= ptx + 1 &&
+			gp_gen [3] + 1 >= pty && gp_gen [3] <= pty + 1) { rdm = rda; break; }
+	}
+	if (rdm == 0xff) return;
+	_x = gp_gen [2]; _y = gp_gen [3];
+	bump_ok = 0;
+
+	// Coger lo que hay
+	gp_gen = ent + (rdm << 2);
+	rdc = gp_gen [0];
+	gp_gen [1] = 0xff;
+
+	// Dejar lo que llevabas, si tiene entrada (los tesoros y los pedestales)
+	for (rda = 0; rda < N_ENTRIES; rda ++) {
+		gp_gen = ent + (rda << 2);
+		if (gp_gen [1] == 0xff && gp_gen [0] == hand && (hand == 0 || hand > 3)) {
+			gp_gen [1] = n_pant; gp_gen [2] = _x; gp_gen [3] = _y;
+			ent_draw ();
+			break;
+		}
+	}
+	if (rda == N_ENTRIES) {
+		// Una llave en la mano o nada que dejar: se queda vacio
+		if (hand >= 1 && hand <= 3) {
+			// Las llaves tambien se dejan (en el original vuelven a la lista de objetos)
+			gp_gen = ent + ((hand + 5) << 2);
+			gp_gen [1] = n_pant; gp_gen [2] = _x; gp_gen [3] = _y;
+			ent_draw ();
+		} else clear_tile ();
+	}
+
+	hand = rdc;
+	hud_hand ();
+}
+
+// Agujero (D27C)
+void game_trap (void) {
+	flash ();
+	gp_gen = holes + (hand >= 4 ? 48 : (rand () & 15) * 3);
+	n_pant = gp_gen [0]; ptx = gp_gen [1]; pty = gp_gen [2];
+	o_pant = 0xff;
+}
+
+void game_tick (void) {
+	if (pdirection == 0xff) bump_ok = 1;
+}
+
+void game_wanderer_touch (void) {
+}
+
+void check_win (void) {
+	if (ent [1] == win_rooms [0] && ent [5] == win_rooms [1] && ent [9] == win_rooms [2]) {
+		game_result = RESULT_WIN; playing = 0;
+	}
+}
