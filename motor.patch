new file mode 100644
index 0000000..80c7095
--- /dev/null
+++ b/dev/patrol.h
@@ -0,0 +1,59 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Patrulleros (ENABLE_PATROLS): como mucho uno por pantalla, definido en el
+// mapa (map/patrols.txt -> assets/patrols.h). Va y viene entre dos limites,
+// un caracter por vuelta, en horizontal o en vertical, y si te toca pierdes
+// una vida (Babaliba, BASIC 270-390).
+//
+//   PATROL_FRAME(t)     Frame del sprite del tipo t
+//   PATROL_VERTICAL(t)  Tipos que se mueven en vertical
+
+unsigned char pat_on, pat_x, pat_y, pat_lo, pat_hi, pat_vert, pat_frame, pat_step;
+signed char pat_d;
+
+void patrol_init (void) {
+	pat_on = 0;
+	gp_gen = patrols;
+	for (gpit = 0; gpit < N_PATROLS; gpit ++) {
+		if (gp_gen [0] == n_pant) {
+			pat_on = 1;
+			pat_vert = PATROL_VERTICAL (gp_gen [1]);
+			pat_frame = PATROL_FRAME (gp_gen [1]);
+			pat_x = gp_gen [2]; pat_y = gp_gen [3];
+			pat_lo = gp_gen [4]; pat_hi = gp_gen [5];
+			rda = pat_vert ? pat_y : pat_x;
+			pat_d = (rda < pat_hi) ? 1 : -1;
+			pat_step = 0;
+			return;
+		}
+		gp_gen += 6;
+	}
+}
+
+void patrol_move (void) {
+	if (pat_on == 0) return;
+	#ifdef ENABLE_BOMBS
+		if (enemies_off_ct && enemies_off_room == n_pant) return;
+	#endif
+	if (pat_vert) {
+		pat_y += pat_d; rda = pat_y;
+	} else {
+		pat_x += pat_d; rda = pat_x;
+	}
+	if (rda <= pat_lo) pat_d = 1;
+	if (rda >= pat_hi) pat_d = -1;
+	pat_step ^= 1;
+}
+
+unsigned char patrol_collide (void) {
+	if (pat_on == 0) return 0;
+	#ifdef ENABLE_BOMBS
+		if (enemies_off_ct && enemies_off_room == n_pant) return 0;
+	#endif
+	if (px + 2 >= pat_x && px <= pat_x + 2 && py + 2 >= pat_y && py <= pat_y + 2) {
+		lose_life ();
+		return 1;
+	}
+	return 0;
+}
