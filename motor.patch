diff --git a/dev/items.h b/dev/items.h
new file mode 100644
index 0000000..b4842e7
--- /dev/null
+++ b/dev/items.h
@@ -0,0 +1,70 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Objetos colocados al azar en una lista de sitios (ENABLE_ITEMS), como las
+// llaves y las letras del hechizo de Babaliba (BASIC 2160-2240, 820-860).
+//
+// data.h define:
+//   N_ITEMS, item_mt [N_ITEMS]                     metatile de cada objeto
+//   N_ITEM_LOCS, item_locs [N_ITEM_LOCS * 3]       sitios posibles: sala, x, y (tiles)
+//
+// Los objetos no estan en el mapa hasta que se llama a items_place (a, b).
+// Se recogen al ponerse al lado (distancia 1 en tiles, diagonales incluidas)
+// si game_item_pickup (i) lo permite (GAME_HOOKS; sin ganchos, siempre).
+
+unsigned char item_room [N_ITEMS];
+unsigned char item_x [N_ITEMS];
+unsigned char item_y [N_ITEMS];
+unsigned char item_i;
+
+void items_init (void) {
+	for (item_i = 0; item_i < N_ITEMS; item_i ++) item_room [item_i] = 0xff;
+}
+
+void item_draw (void) {
+	_x = item_x [item_i]; _y = item_y [item_i];
+	draw_tile (_x, _y, item_mt [item_i]);
+	set_attr (tile_behs [item_mt [item_i]]);
+	invalidate_tile (_x, _y);
+}
+
+// Reparte los objetos a..b (incluidos) en sitios distintos al azar
+void items_place (unsigned char a, unsigned char b) {
+	for (item_i = a; item_i <= b; item_i ++) {
+		while (1) {
+			rda = rand () % N_ITEM_LOCS;
+			gp_gen = item_locs + (rda << 1) + rda;
+			for (rdb = 0; rdb < N_ITEMS; rdb ++) {
+				if (rdb != item_i && item_room [rdb] == gp_gen [0] &&
+					item_x [rdb] == gp_gen [1] && item_y [rdb] == gp_gen [2]) break;
+			}
+			if (rdb == N_ITEMS) break;
+		}
+		item_room [item_i] = gp_gen [0];
+		item_x [item_i] = gp_gen [1];
+		item_y [item_i] = gp_gen [2];
+		if (item_room [item_i] == n_pant && o_pant == n_pant) item_draw ();
+	}
+}
+
+void items_enter_room (void) {
+	for (item_i = 0; item_i < N_ITEMS; item_i ++) {
+		if (item_room [item_i] == n_pant) item_draw ();
+	}
+}
+
+void items_tick (void) {
+	for (item_i = 0; item_i < N_ITEMS; item_i ++) {
+		if (item_room [item_i] == n_pant) {
+			rda = item_x [item_i]; rdb = item_y [item_i];
+			if (rda + 1 >= ptx && rda <= ptx + 1 && rdb + 1 >= pty && rdb <= pty + 1) {
+				#ifdef GAME_HOOKS
+					if (game_item_pickup () == 0) continue;
+				#endif
+				item_room [item_i] = 0xff;
+				_x = item_x [item_i]; _y = item_y [item_i];
+				clear_tile ();
+			}
+		}
+	}
+}
