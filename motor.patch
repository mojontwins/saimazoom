diff --git a/games/alibebe/map/patrols.txt b/games/alibebe/map/patrols.txt
new file mode 100644
index 0000000..4b98d28
--- /dev/null
+++ b/games/alibebe/map/patrols.txt
@@ -0,0 +1,3 @@
+# Enemigos patrulleros: sala(0-based) tipo x y min max
+# tipo 0-4 (44-48 en el original). 3 y 4 se mueven en vertical.
+# El movimiento es por caracteres; x,y,min,max en caracteres del area de juego.
diff --git a/games/babaliba/config.h b/games/babaliba/config.h
new file mode 100644
index 0000000..85b7e3f
--- /dev/null
+++ b/games/babaliba/config.h
@@ -0,0 +1,91 @@
+// Babaliba CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Configuracion del motor para Babaliba (Dinamic, 1984).
+// Referencias "BASIC nnnn" = lineas del listado decompilado del original.
+
+// --------------------------------------------------------------------------
+// Geometria
+// --------------------------------------------------------------------------
+
+#define ROOM_W              10      // 30 x 15 caracteres, como en el Spectrum
+#define ROOM_H              5
+#define ROOM_X              1       // Dentro de un marco de un caracter
+#define ROOM_Y              1
+#define MAP_W               15      // Las salas se numeran 0-134 (original 1-135)
+#define MAP_ROOMS           135
+
+#define MAP_PACKED                  // Cada pantalla comprimida con zx0
+#define TILESET_DYNAMIC             // Metatiles = grafico base + recoloreo
+#define DYN_SLOTS           25      // Huecos de 9 patrones (9 fijos para el marcador)
+
+#define SPRITES_N           3       // Jugador, monstruo errante, patrullero
+#define SPRITE_OFF_X        29      // Esquina inferior derecha, fuera del area
+#define SPRITE_OFF_Y        21
+
+// --------------------------------------------------------------------------
+// Inicio y ritmo
+// --------------------------------------------------------------------------
+
+#define SCR_INI             74      // Sala 75 del original
+#define PLAYER_INI_X        7       // Fila 7, columna 22
+#define PLAYER_INI_Y        2
+#define PLAYER_INI_FACING   6       // Mirando a la izquierda
+
+// El bucle del original tarda ~2.1 frames parado y ~2.6 andando (medido en
+// un Spectrum emulado). Aqui vamos fijos a 25 Hz.
+#define FRAMES_PER_TICK     2
+
+#define MENU_KEY_KBD        0x4608  // "T" teclado
+#define MENU_KEY_JOY        0x4420  // "K" joystick (en el original, Kempston)
+#define BORDER_COLOUR       0x54    // Negro
+#define DEATH_FLASH
+
+// --------------------------------------------------------------------------
+// Marcador
+// --------------------------------------------------------------------------
+
+#define LIVES_INI           5
+#define LIVES_ZERO_ENDS             // Con 0 vidas se acaba
+#define LIVES_X             26
+#define LIVES_Y             18
+#define RESPAWN_AT_ROOM_ENTRY       // Al morir vuelves a donde entraste
+
+#define TIMER_DOWN                  // BASIC 420: 2000, baja 1 cada 10 vueltas
+#define TIME_INI            2000
+#define TIME_TICKS          12      // 10 vueltas de ~2.5 frames = 12 ticks de 2
+#define TIME_X              2
+#define TIME_Y              19
+
+// --------------------------------------------------------------------------
+// Reglas
+// --------------------------------------------------------------------------
+
+#define ENABLE_TRAPS                // Tiles con BEH_TRAP (el dragon) quitan una vida
+
+#define ENABLE_WANDERER
+#define WANDERER_SPAWN_ON_ENTER     // BASIC 1150
+#define WANDERER_EVERY      2       // Se mueve una vuelta de cada dos (BASIC 890)
+#define WANDERER_KINDS      3
+#define WANDERER_FRAME(k)   (8 + ((k) << 1))
+#define WANDERER_FLEE_FRAME 18      // La princesa
+#define WANDERER_PUFF_FRAME 8
+#define WANDERER_BLOCK_MASK 2       // BEH_PLANT: lo que no es suelo (atributo 0 o 6)
+#define WANDERER_AI_BABALIBA
+
+#define ENABLE_PATROLS              // BASIC 270-390
+#define PATROL_FRAME(t)     (8 + ((t) << 1))
+#define PATROL_VERTICAL(t)  ((t) > 2)
+
+#define ENABLE_BOMBS                // BASIC 500-600
+#define BOMBS_INI           20
+#define BOMB_FUSE           75      // 60 vueltas del original
+#define BOMB_CLEAR_TICKS    218     // 174 vueltas: enemigos fuera de esa sala
+#define BOMBS_X             18
+#define BOMBS_Y             18
+
+#define ENABLE_ITEMS                // Llaves y letras del hechizo
+#define ENABLE_ROOM_TELEPORTS       // Agujeros (BASIC 2030)
+
+#define GAME_HOOKS                  // game_init, game_enter_room, game_tick...
+#define GAME_CHECK_WIN
