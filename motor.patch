diff --git a/utils/mkassets.py b/utils/mkassets.py
new file mode 100644
index 0000000..c2c3d49
--- /dev/null
+++ b/utils/mkassets.py
@@ -0,0 +1,340 @@
+#!/usr/bin/env python3
+# mkassets.py - conversor de graficos y mapas para el motor Saimazoom CPC.
+# Copyleft 2023 by The Mojon Twins
+#
+# Reimplementa en Python (multiplataforma) los modos de mkts_om.exe y de
+# mapcnv.exe que usa el motor, con salida identica byte a byte, y anade los
+# modos nuevos que necesitan los juegos derivados (metatiles con variantes de
+# color para el tileset dinamico, mapas por listas, etc).
+#
+# Requiere Python 3 y Pillow (pip install pillow).
+#
+# Uso como modulo: import mkassets; mkassets.mapped (...)
+# Uso desde linea de comandos: ver "python mkassets.py help".
+
+import sys, os
+
+try:
+	from PIL import Image
+except ImportError:
+	sys.exit ("mkassets: hace falta Pillow (pip install pillow)")
+
+GREY_ROW_ORDER = (0, 1, 3, 2, 6, 7, 5, 4)
+
+# CPC hardware colours: (r, g, b) en niveles 0/1/2, como en mkts_om
+CPC_HW = [
+	(1,1,1), None, (0,2,1), (2,2,1), (0,0,1), (2,0,1), (0,1,1), (2,1,1),
+	None, None, (2,2,0), (2,2,2), (2,0,0), (2,0,2), (2,1,0), (2,1,2),
+	None, None, (0,2,0), (0,2,2), (0,0,0), (0,0,2), (0,1,0), (0,1,2),
+	(1,0,1), (1,2,1), (1,2,0), (1,2,2), (1,0,0), (1,0,2), (1,1,0), (1,1,2)
+]
+
+def third (v):
+	return 0 if v < 85 else (1 if v < 170 else 2)
+
+def promote (t):
+	return (0, 128, 255) [t]
+
+def normalize (rgb):
+	return tuple (promote (third (c)) for c in rgb [:3])
+
+def hw_colour (rgb):
+	t = tuple (third (c) for c in rgb [:3])
+	for i, h in enumerate (CPC_HW):
+		if h == t: return i
+	return 0
+
+def load_rgb (fn):
+	return Image.open (fn).convert ("RGB")
+
+class Palette:
+	def __init__ (self, fn):
+		im = load_rgb (fn)
+		self.colours = [normalize (im.getpixel ((i, 0))) for i in range (16)]
+		self.hw = [hw_colour (c) for c in self.colours]
+		self.lut = {}
+		for i in range (15, -1, -1): self.lut [self.colours [i]] = i 	# primera aparicion gana
+
+	def pen (self, rgb):
+		# Como palIndex de mkts_om: 0xFF si no esta (todos los bits a 1)
+		return self.lut.get (normalize (rgb), 0xff)
+
+def bit (v, b):
+	return (v >> b) & 1
+
+def mode0_byte (c1, c2):
+	# PIXEL 0  PIXEL 1
+	# 3 2 1 0  3 2 1 0
+	# 1 5 3 7  0 4 2 6
+	return (bit (c2, 3) | (bit (c1, 3) << 1) | (bit (c2, 1) << 2) | (bit (c1, 1) << 3) |
+		(bit (c2, 2) << 4) | (bit (c1, 2) << 5) | (bit (c2, 0) << 6) | (bit (c1, 0) << 7))
+
+def mode0_pens (b):
+	# Inversa: devuelve (pen pixel 0, pen pixel 1)
+	c1 = bit (b, 7) | (bit (b, 3) << 1) | (bit (b, 5) << 2) | (bit (b, 1) << 3)
+	c2 = bit (b, 6) | (bit (b, 2) << 1) | (bit (b, 4) << 2) | (bit (b, 0) << 3)
+	return c1, c2
+
+class PenImage:
+	# Imagen convertida a indices de paleta (pens)
+	def __init__ (self, fn, pal):
+		im = load_rgb (fn)
+		self.w, self.h = im.size
+		px = im.load ()
+		self.p = [[pal.pen (px [x, y]) for x in range (self.w)] for y in range (self.h)]
+
+	def get (self, x, y):
+		if 0 <= x < self.w and 0 <= y < self.h: return self.p [y][x]
+		return 0
+
+	def byte (self, x, y):
+		return mode0_byte (self.get (x, y), self.get (x + 1, y))
+
+	def pattern (self, x, y):
+		# Patron 4x8 = 16 bytes, 2 por fila
+		out = []
+		for yy in range (8):
+			out.append (self.byte (x, y + yy))
+			out.append (self.byte (x + 2, y + yy))
+		return bytes (out)
+
+def grey_order (data):
+	# Formato Grey + ZigZag de mkts_om (lo que espera cpc_UpdScr)
+	out = bytearray ()
+	for i in range (0, len (data), 16):
+		chunk = data [i:i+16]
+		for j in range (8):
+			g = GREY_ROW_ORDER [j] * 2
+			if (j & 1) == 0: out += chunk [g:g+2]
+			else: out += bytes ((chunk [g+1], chunk [g]))
+	return bytes (out)
+
+def write (fn, data):
+	d = os.path.dirname (fn)
+	if d: os.makedirs (d, exist_ok = True)
+	mode = "wb" if isinstance (data, (bytes, bytearray)) else "w"
+	with open (fn, mode) as f: f.write (data)
+
+# ---------------------------------------------------------------------------
+# Modos de mkts_om
+# ---------------------------------------------------------------------------
+
+def chars (img, offset = (0, 0), size = None, max = -1, grey = False):
+	# mode=chars: patrones sueltos de izquierda a derecha y de arriba a abajo
+	x0, y0 = offset [0] * 4, offset [1] * 8
+	w, h = size if size else (img.w // 4, img.h // 8)
+	out = bytearray (); ct = 0
+	# Igual que mkts_om: y1 se calcula (por error) con x0, lo replicamos
+	y1 = x0 + h * 8 - 1
+	y = y0
+	while y <= y1:
+		for x in range (x0, x0 + w * 4, 4):
+			out += img.pattern (x, y); ct += 1
+			if max != -1 and ct == max: break
+		if max != -1 and ct == max: break
+		y += 8
+	return grey_order (out) if grey else bytes (out)
+
+def mapped (img, offset = (0, 0), size = None, meta = (3, 3), max = -1, tmapoffs = 0, grey = True, pool = None):
+	# mode=mapped: metatiles deduplicando patrones. Devuelve (tileset, tsmaps)
+	wm, hm = meta
+	x0, y0 = offset [0] * 4, offset [1] * 8
+	w, h = size if size else (img.w // (wm * 4), img.h // (hm * 8))
+	pool = pool if pool is not None else {}
+	idx = [tmapoffs]
+	out = bytearray (); tmaps = bytearray ()
+	for y in range (y0, y0 + h * hm * 8, 8 * wm):
+		for x in range (x0, x0 + w * wm * 4, 4 * hm):
+			ya = y
+			for yy in range (hm):
+				xa = x
+				for xx in range (wm):
+					p = img.pattern (xa, ya)
+					if p not in pool:
+						pool [p] = idx [0]; idx [0] += 1
+						out += p
+					tmaps.append (pool [p])
+					xa += 4
+				ya += 8
+	return (grey_order (out) if grey else bytes (out)), bytes (tmaps)
+
+def sprites (img, offset = (0, 0), size = None, meta = (3, 3), max = -1):
+	# mode=sprites (CPC): cada sprite fila a fila, 2 bytes por patron de ancho
+	wm, hm = meta
+	x0, y0 = offset [0] * 4, offset [1] * 8
+	w, h = size if size else (img.w // (wm * 4), img.h // (hm * 8))
+	out = bytearray (); ct = 0
+	for y in range (y0, y0 + h * hm * 8, hm * 8):
+		for x in range (x0, x0 + w * wm * 4, wm * 4):
+			for yy in range (hm * 8):
+				xa = x
+				for xx in range (wm):
+					out.append (img.byte (xa, y + yy))
+					out.append (img.byte (xa + 2, y + yy))
+					xa += 4
+			ct += 1
+			if max > 0 and ct == max: return bytes (out), ct
+	return bytes (out), ct
+
+def sprite_mappings (n, meta = (3, 3)):
+	# Equivalente a generateStraitMappings (solo 3x3, que es lo que usa el motor)
+	cell = 16 * meta [0] * meta [1]
+	def rows (items, per, indent = "\t"):
+		s = ""
+		for i in range (0, len (items), per):
+			s += indent + ", ".join (items [i:i+per]) + (",\n" if i + per < len (items) else "\n")
+		return s
+	t  = "// Spriteset mappings. Generado por mkassets.py\n"
+	t += "// One entry per sprite face in the spriteset!\n\n"
+	t += "#define SWsprites_ALL  16\n\n"
+	t += "unsigned char sm_cox [] = {\n" + rows (["0x00"] * n, 8) + "};\n\n"
+	t += "unsigned char sm_coy [] = {\n" + rows (["0x00"] * n, 8) + "};\n\n"
+	t += "void *sm_invfunc [] = {\n" + rows (["cpc_PutSpTileMap12x24CA"] * n, 4) + "};\n\n"
+	t += "void *sm_updfunc [] = {\n" + rows (["cpc_PutTrSp12x24TileMap2bGCA"] * n, 4) + "};\n\n"
+	t += "extern void *sm_sprptr [0];\n#asm\n\t._sm_sprptr\n"
+	for i in range (0, n, 4):
+		t += "\t\tdefw " + ", ".join ("_sprites + 0x%04X" % (j * cell) for j in range (i, min (n, i + 4))) + "\n"
+	t += "#endasm\n\n"
+	for i in range (n):
+		t += "#define SPRITE_%02X (_sprites + 0x%04X)\n" % (i, i * cell)
+	return t
+
+def superbuffer (img):
+	out = bytearray ()
+	for y in range (192):
+		for x in range (64):
+			out.append (img.byte (x * 2, y))
+	return bytes (out)
+
+def pals (pal, prefix = "my_inks"):
+	t  = "// CPC Palette with HW values\n// Generado por mkassets.py\n\n"
+	t += "const unsigned char %s [] = {\n" % prefix
+	for i in range (16):
+		r, g, b = pal.colours [i]
+		t += "\t0x%02X%s// FF%02X%02X%02X\n" % (pal.hw [i], ", " if i < 15 else "  ", r, g, b)
+	t += "};\n\n"
+	return t
+
+# ---------------------------------------------------------------------------
+# mapcnv
+# ---------------------------------------------------------------------------
+
+def mapcnv (mapfn, map_w, map_h, room_w, room_h):
+	# Mapa crudo de Mappy (un byte por tile, ancho = map_w * room_w)
+	# a pantallas consecutivas de room_w * room_h bytes.
+	m = open (mapfn, "rb").read ()
+	W = map_w * room_w
+	out = bytearray ()
+	for ry in range (map_h):
+		for rx in range (map_w):
+			for y in range (room_h):
+				for x in range (room_w):
+					out.append (m [(ry * room_h + y) * W + rx * room_w + x])
+	return bytes (out)
+
+def c_array (name, data, per = 16, ctype = "unsigned char"):
+	t = "%s %s [] = {\n" % (ctype, name)
+	for i in range (0, len (data), per):
+		t += "\t" + ", ".join ("0x%02X" % b for b in data [i:i+per])
+		t += ",\n" if i + per < len (data) else "\n"
+	return t + "};\n\n"
+
+# ---------------------------------------------------------------------------
+# Metatiles con variantes de color (tileset dinamico)
+# ---------------------------------------------------------------------------
+#
+# Un "metatile de mapa" es (grafico base, tabla de recoloreo). Los graficos base
+# estan en un PNG (12x24 cada uno, editables a mano). Las variantes se definen en
+# un fichero de texto con una linea por metatile:
+#
+#     <id> <base> [pen_origen>pen_destino ...] [beh=n]
+#
+# El motor, al entrar en una pantalla, copia los patrones de los metatiles que
+# usa a una zona dinamica del tileset aplicando el recoloreo.
+
+def parse_metatiles (fn):
+	mts = []
+	for line in open (fn):
+		line = line.split ("#") [0].strip ()
+		if not line: continue
+		tok = line.split ()
+		mid, base = int (tok [0]), int (tok [1])
+		remap = list (range (16)); beh = 0
+		for t in tok [2:]:
+			if t.startswith ("beh="): beh = int (t [4:], 0)
+			elif ">" in t:
+				a, b = t.split (">"); remap [int (a)] = int (b)
+		while len (mts) <= mid: mts.append (None)
+		mts [mid] = (base, remap, beh)
+	return mts
+
+def base_tiles (img, n, cols = None, meta = (3, 3)):
+	# Lee n metatiles base (12x24) del PNG, por filas. Devuelve lista de 9 patrones.
+	wm, hm = meta
+	cols = cols or img.w // (wm * 4)
+	res = []
+	for i in range (n):
+		x0 = (i % cols) * wm * 4; y0 = (i // cols) * hm * 8
+		res.append ([img.pattern (x0 + (c % wm) * 4, y0 + (c // wm) * 8) for c in range (wm * hm)])
+	return res
+
+def recolour_pattern (p, remap):
+	out = bytearray ()
+	for b in p:
+		c1, c2 = mode0_pens (b)
+		out.append (mode0_byte (remap [c1], remap [c2]))
+	return bytes (out)
+
+# ---------------------------------------------------------------------------
+# Linea de comandos (subconjunto compatible con mkts_om / mapcnv)
+# ---------------------------------------------------------------------------
+
+def _args (argv):
+	d = {}
+	for a in argv:
+		if "=" in a:
+			k, v = a.split ("=", 1); d [k.lower ()] = v
+		else: d [a.lower ()] = "1"
+	return d
+
+def _xy (s, default = None):
+	if not s: return default
+	a, b = s.split (","); return int (a), int (b)
+
+def main (argv):
+	if len (argv) < 2 or argv [1] == "help":
+		print ("mkassets.py mode=chars|mapped|sprites|superbuffer|pals pal=pal.png in=in.png out=out.bin")
+		print ("            [offset=x,y] [size=w,h] [max=n] [metasize=3,3] [tmapoffs=n] [greyordered]")
+		print ("            [mappings=file] [prefix=name]")
+		print ("mkassets.py mapcnv in.map out.h map_w map_h room_w room_h")
+		return
+	if argv [1] == "mapcnv":
+		f, o, mw, mh, rw, rh = argv [2:8]
+		data = mapcnv (f, int (mw), int (mh), int (rw), int (rh))
+		write (o, "// Generado por mkassets.py (mapcnv)\n\n" + c_array ("mapa", data))
+		return
+	a = _args (argv [1:])
+	mode = a.get ("mode")
+	pal = Palette (a ["pal"] if mode != "pals" else a ["in"])
+	if mode == "pals":
+		write (a ["out"], pals (pal, a.get ("prefix", "my_inks"))); return
+	img = PenImage (a ["in"], pal)
+	off = _xy (a.get ("offset"), (0, 0)); size = _xy (a.get ("size")); meta = _xy (a.get ("metasize"), (3, 3))
+	mx = int (a.get ("max", "-1")); grey = "greyordered" in a
+	if mode == "chars":
+		write (a ["out"], chars (img, off, size, mx, grey))
+	elif mode == "mapped":
+		ts, tm = mapped (img, off, size, meta, mx, int (a.get ("tmapoffs", "0")), grey)
+		write (a ["out"], ts)
+		if "mappings" in a: write (a ["mappings"], tm)
+	elif mode == "sprites":
+		data, n = sprites (img, off, size, meta, mx)
+		write (a ["out"], data)
+		if "mappings" in a: write (a ["mappings"], sprite_mappings (n, meta))
+	elif mode == "superbuffer":
+		write (a ["out"], superbuffer (img))
+	else:
+		sys.exit ("mkassets: modo desconocido " + str (mode))
+
+if __name__ == "__main__":
+	main (sys.argv)
diff --git a/utils/zx2cpc/zx2cpc.py b/utils/zx2cpc/zx2cpc.py
new file mode 100644
index 0000000..b4b2094
--- /dev/null
+++ b/utils/zx2cpc/zx2cpc.py
@@ -0,0 +1,259 @@
+#!/usr/bin/env python3
+# zx2cpc.py - extrae graficos y mapa de juegos de Spectrum hechos con el
+# "motor Babaliba" (BASIC compilado de Dinamic, 1984-85) y genera el material
+# de partida para games/<juego> en modo 0.
+# Copyleft 2023 by The Mojon Twins
+#
+# Uso: python zx2cpc.py <perfil> juego.z80 menu.scr juego.scr <carpeta games/juego>
+#
+#   perfil: babaliba | alibebe
+#   menu.scr / juego.scr: volcados de pantalla (6912 bytes) del menu y del
+#   juego recien empezado (sirven para sacar el titulo y el marcador).
+#
+# Todo lo que se genera esta pensado para retocarlo a mano despues:
+#   gfx/palette.png    paleta (pens 0-15)
+#   gfx/tiles.png      graficos base de los metatiles (12x24, 10 por fila)
+#   gfx/metatiles.txt  metatiles de mapa = grafico base + recoloreo + comportamiento
+#   gfx/sprites.png    sprites 12x24
+#   gfx/font.png       digitos del marcador (10 caracteres 4x8)
+#   gfx/marcador.png   marco y marcador (128x192)
+#   gfx/menu.png       pantalla de titulo (128x192)
+#   gfx/mappy.png      todos los metatiles de mapa, para editar con Mappy
+#   map/mapa.map       mapa crudo (un byte por metatile), 15x9 pantallas de 10x5
+#   map/patrols.txt    enemigos patrulleros (uno por pantalla como mucho)
+
+import sys, os, collections
+sys.path.insert (0, os.path.dirname (os.path.abspath (__file__)))
+from zxlib import *
+
+MAP = 35501; TILES = 30448; ATTRS = 33472; CHARS = 0x72D8
+NROOMS = 135; MAP_W = 15; ROOM_W = 10; ROOM_H = 5
+
+def T (t): return TILES + t * 72
+
+# ---------------------------------------------------------------------------
+# Perfiles
+# ---------------------------------------------------------------------------
+
+def beh_babaliba (attrs):
+	# Como el original, que mira atributos en pantalla:
+	#   8  = obstaculo (la celda superior izquierda tiene BRIGHT)
+	#   64 = trampa (atributo 5: el dragon)
+	#   2  = el monstruo errante no puede pisarlo (celda central ni 0 ni 6)
+	b = 0
+	if attrs [0] & 64: b |= 8
+	if attrs [0] == 5: b |= 64
+	if attrs [4] not in (0, 6): b |= 2
+	return b
+
+def beh_alibebe (attrs):
+	# Ali Bebe (BASIC 1330, 1110): fondo azul (9); >= 64 obstaculo;
+	# 13 agujero (te lleva a otro sitio); el monstruo solo pisa 9 o 13.
+	b = 0
+	if attrs [0] >= 64: b |= 8
+	if attrs [0] == 13: b |= 64
+	if attrs [4] not in (9, 13, 0): b |= 2
+	return b
+
+PROFILES = {
+	"babaliba": dict (
+		row0 = 1, beh = beh_babaliba, pen_swap = None,
+		extras = [
+			(T (36), 7, "LETTER_B"), (T (37), 7, "LETTER_A"), (T (38), 7, "LETTER_L"), (T (39), 7, "LETTER_I"),
+			(T (41), 33, "KEY_A"), (T (41), 34, "KEY_B"), (T (35), 39, "TREASURE"),
+			(28864, [0x46] * 9, "PRISONER_A"), (28936, [0x46] * 9, "PRISONER_B"),
+			(28864, 36, "HUD_PRISONER"), (27712, 7, "HUD_PRINCESS"),
+			(28000, [0x47] * 3 + [0x43] * 6, "BOMB"),
+			(T (18), 2, "DOOR_16"), (T (18), 5, "DOOR_52"),
+		],
+		# arriba, derecha, abajo, izquierda (como el motor); direccion del original
+		player = (2, 3, 1, 4), player_attrs = [0x45] * 3 + [0x06] * 6,
+		sprites = [((28144, 28216), [0x47] * 9), ((28288, 28360), [0x46] * 9), ((28432, 28504), [0x43] * 9),
+			((28576, 28648), [0x45] * 9), ((28720, 28792), [0x42] * 9),
+			((27712, 27784), [0x47] * 3 + [0x44] * 6), ((27856, 27928), [0x47] * 3 + [0x44] * 6)],
+		clears = [(1, 1, 30, 15), (2, 19, 4, 1), (18, 18, 2, 1), (26, 18, 1, 1), (8, 17, 9, 3)],
+		font_ink = 14, font_paper = 0,
+	),
+	"alibebe": dict (
+		row0 = 5, beh = beh_alibebe,
+		# El fondo es azul (atributo 9): el pen 0 (el vacio y lo transparente
+		# de los sprites) pasa a ser el azul, y el negro va al pen 1.
+		pen_swap = (0, 1),
+		extras = [
+			(28864, [0x4e] * 9, "OBJ_LAMP"), (28936, [0x4e] * 9, "OBJ_SWORD"), (28720, [0x4e] * 9, "OBJ_3"),
+		],
+		player = (2, 3, 1, 4), player_attrs = [0x04] * 3 + [0x05] * 6,
+		sprites = [((28144, 28216), [0x47] * 9), ((28288, 28360), [0x46] * 9), ((28432, 28504), [0x43] * 9),
+			((27712, 27784), [0x47] * 9), ((27856, 27928), [0x47] * 9)],
+		clears = [(1, 5, 30, 15), (8, 3, 1, 1), (17, 3, 2, 1), (28, 2, 3, 1)],
+		font_ink = 11, font_paper = 0,
+	),
+}
+
+def main (profile, snap, menu_scr, game_scr, out):
+	P = PROFILES [profile]
+	m = unz80 (snap)
+	os.makedirs (out + "/gfx", exist_ok = True)
+	os.makedirs (out + "/map", exist_ok = True)
+
+	def attrset (a): return list (m [ATTRS + a * 9:ATTRS + a * 9 + 9])
+	def attrs_of (a): return a if isinstance (a, list) else attrset (a)
+
+	swap = {}
+	pal = list (PALETTE)
+	if P ["pen_swap"]:
+		a, b = P ["pen_swap"]; swap = {a: b, b: a}
+		pal [a], pal [b] = pal [b], pal [a]
+	set_palette (pal)
+	def sw (pens):
+		return [[swap.get (p, p) for p in row] for row in pens]
+
+	# --- Mapa original: registros por pantalla ---
+	rooms = []; patrols = []
+	p = MAP
+	for r in range (NROOMS):
+		l = m [p]; i = p + 1; ents = []
+		while i <= p + l - 3:
+			t = m [i]
+			if t > 43:
+				patrols.append ((r + 1,) + tuple (m [i:i+6])); i += 6; continue
+			ents.append (tuple (m [i:i+4])); i += 4
+		rooms.append (ents); p += l
+
+	# --- Metatiles (combinaciones grafico + juego de atributos) ---
+	combos = []; names = {}
+	def add (gaddr, attrs, name = None):
+		k = (gaddr, tuple (attrs))
+		if k not in combos: combos.append (k)
+		if name: names [combos.index (k) + 1] = name
+		return combos.index (k) + 1 		# el 0 es "vacio"
+
+	used = collections.Counter ()
+	for ents in rooms:
+		for t, a, row, col in ents: used [(t, a)] += 1
+	for (t, a) in sorted (used): add (T (t), attrset (a))
+	for gaddr, a, name in P ["extras"]: add (gaddr, attrs_of (a), name)
+
+	imgs = [sw (block (m, k [0], k [1])) for k in combos]
+
+	# Bases: agrupamos las variantes que son un recoloreo de otra
+	def fmap (base, img):
+		f = {}
+		for y in range (24):
+			for x in range (12):
+				b = base [y][x]; v = img [y][x]
+				if f.setdefault (b, v) != v: return None
+		return f
+
+	bygfx = collections.OrderedDict ()
+	for i, k in enumerate (combos): bygfx.setdefault (k [0], []).append (i)
+	bases = []; mt = {}
+	for g, idxs in bygfx.items ():
+		pending = list (idxs)
+		while pending:
+			best = None
+			for a in pending:
+				cov = [b for b in pending if fmap (imgs [a], imgs [b]) is not None]
+				if best is None or len (cov) > len (best [1]): best = (a, cov)
+			a, cov = best
+			bi = len (bases); bases.append (imgs [a])
+			for b in cov: mt [b + 1] = (bi, fmap (imgs [a], imgs [b]))
+			pending = [b for b in pending if b not in cov]
+
+	# tiles.png
+	cols = 10
+	rows = (len (bases) + cols - 1) // cols
+	img = new_image (128, rows * 24)
+	for i, b in enumerate (bases): paste_pens (img, b, (i % cols) * 12, (i // cols) * 24)
+	img.save (out + "/gfx/tiles.png")
+
+	# metatiles.txt
+	with open (out + "/gfx/metatiles.txt", "w") as f:
+		f.write ("# Metatiles de mapa: <id> <grafico base en tiles.png> [pen>pen ...] [beh=n] [name=X]\n")
+		f.write ("# beh: 8 obstaculo, 16 cerrojo, 32 objeto, 64 trampa, 2 bloquea al monstruo errante\n")
+		f.write ("0 0 " + " ".join ("%d>0" % i for i in range (16)) + " name=EMPTY\n")
+		for i, k in enumerate (combos):
+			mid = i + 1
+			bi, f_ = mt [mid]
+			remap = " ".join ("%d>%d" % (s, d) for s, d in sorted (f_.items ()) if s != d)
+			line = "%d %d" % (mid, bi)
+			if remap: line += " " + remap
+			bb = P ["beh"] (k [1])
+			if bb: line += " beh=%d" % bb
+			if mid in names: line += " name=" + names [mid]
+			gaddr = k [0]
+			src = ("tile %d" % ((gaddr - TILES) // 72)) if TILES <= gaddr < TILES + 44 * 72 else ("gfx %d" % gaddr)
+			f.write ("%-60s # %s attrs %s\n" % (line, src, " ".join ("%02x" % a for a in k [1])))
+
+	# mappy.png: todos los metatiles (el 0 es el vacio)
+	n = len (combos) + 1
+	img = new_image (12 * 16, 24 * ((n + 15) // 16))
+	paste_pens (img, [[0] * 12 for _ in range (24)], 0, 0)
+	for i in range (1, n): paste_pens (img, imgs [i - 1], ((i % 16) * 12), (i // 16) * 24)
+	img.save (out + "/gfx/mappy.png")
+
+	# Mapa crudo: (15*10) x (9*5)
+	r0 = P ["row0"]
+	W = MAP_W * ROOM_W; H = (NROOMS // MAP_W) * ROOM_H
+	raw = bytearray (W * H)
+	for r, ents in enumerate (rooms):
+		rx, ry = r % MAP_W, r // MAP_W
+		for t, a, row, col in ents:
+			x = (col - 1) // 3; y = (row - r0) // 3
+			mid = combos.index ((T (t), tuple (attrset (a)))) + 1
+			raw [(ry * ROOM_H + y) * W + rx * ROOM_W + x] = mid
+	open (out + "/map/mapa.map", "wb").write (raw)
+
+	# Patrulleros: sala tipo x y min max (en caracteres del area de juego)
+	with open (out + "/map/patrols.txt", "w") as f:
+		f.write ("# Enemigos patrulleros: sala(0-based) tipo x y min max\n")
+		f.write ("# tipo 0-4 (44-48 en el original). 3 y 4 se mueven en vertical.\n")
+		f.write ("# El movimiento es por caracteres; x,y,min,max en caracteres del area de juego.\n")
+		for (r, t, ink, row, col, l1, l2) in patrols:
+			vert = t > 46
+			lo, hi = (min (row, l1), max (row, l1)) if vert else (min (col, l2), max (col, l2))
+			off = r0 if vert else 1
+			f.write ("%d %d %d %d %d %d\n" % (r - 1, t - 44, col - 1, row - r0, lo - off, hi - off))
+
+	# Sprites
+	def spr (addr, attrs):
+		return sw (block (m, addr, attrs, transparent_paper = True))
+	sprites = []
+	for d in P ["player"]:
+		for s in (0, 1): sprites.append (spr (29296 + d * 72 * (1 if s else -1), P ["player_attrs"]))
+	for (a1, a2), attrs in P ["sprites"]:
+		sprites.append (spr (a1, attrs)); sprites.append (spr (a2, attrs))
+	img = new_image (128, 24 * ((len (sprites) + 9) // 10))
+	for i, s in enumerate (sprites): paste_pens (img, s, (i % 10) * 12, (i // 10) * 24)
+	img.save (out + "/gfx/sprites.png")
+
+	# Digitos (fuente del juego)
+	img = new_image (40, 8)
+	for d in range (10):
+		paste_pens (img, sw (half_char (m, CHARS + (48 + d) * 8, P ["font_ink"], P ["font_paper"])), d * 4, 0)
+	img.save (out + "/gfx/font.png")
+
+	# Marcador: pantalla de juego sin el area de juego ni los numeros
+	scr = bytearray (65536); scr [0x4000:0x5B00] = open (game_scr, "rb").read ()
+	pens = sw (screen_pens (scr))
+	# El area de juego queda con el pen 0 (el vacio); el resto, en negro
+	for i, (cx, cy, w, h) in enumerate (P ["clears"]):
+		v = 0 if i == 0 else swap.get (0, 0)
+		for y in range (cy * 8, (cy + h) * 8):
+			for x in range (cx * 4, (cx + w) * 4): pens [y][x] = v
+	img = new_image (128, 192); paste_pens (img, pens, 0, 0); img.save (out + "/gfx/marcador.png")
+
+	# Titulo
+	scr [0x4000:0x5B00] = open (menu_scr, "rb").read ()
+	img = new_image (128, 192); paste_pens (img, sw (screen_pens (scr)), 0, 0); img.save (out + "/gfx/menu.png")
+
+	palette_png (out + "/gfx/palette.png", pal)
+
+	print ("%s: %d metatiles de mapa, %d graficos base, %d sprites, %d patrulleros" %
+		(profile, len (combos) + 1, len (bases), len (sprites), len (patrols)))
+	for k, v in sorted (names.items ()): print ("  %3d %s" % (k, v))
+
+if __name__ == "__main__":
+	if len (sys.argv) < 6 or sys.argv [1] not in PROFILES:
+		sys.exit ("uso: zx2cpc.py <%s> juego.z80 menu.scr juego.scr carpeta" % "|".join (PROFILES))
+	main (*sys.argv [1:6])
