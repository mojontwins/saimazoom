+// Ali Bebe CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Configuracion del motor para Ali Bebe (Future Stars / Dinamic, 1985),
+// hecho sobre el motor de Babaliba con parches en codigo maquina.
+//
+// FASE 2 - PRIMERA VERSION: mapa, graficos, monstruo, biberones, tiempo y
+// vidas. Faltan las reglas propias (ver game.h).
+
+// --------------------------------------------------------------------------
+// Geometria
+// --------------------------------------------------------------------------
+
+#define ROOM_W              10
+#define ROOM_H              5
+#define ROOM_X              1
+#define ROOM_Y              5       // El marcador va arriba (filas 0-4)
+#define MAP_W               15
+#define MAP_ROOMS           135
+
+#define MAP_PACKED
+#define TILESET_DYNAMIC
+#define DYN_SLOTS           20
+
+#define SPRITES_N           3       // Jugador, monstruo, biberon
+#define SPRITE_OFF_X        0       // Esquina inferior izquierda, fuera del area
+#define SPRITE_OFF_Y        21
+
+// --------------------------------------------------------------------------
+// Inicio y ritmo
+// --------------------------------------------------------------------------
+
+#define SCR_INI             60      // Sala 61 del original
+#define PLAYER_INI_X        4       // Fila 11, columna 13
+#define PLAYER_INI_Y        2
+#define PLAYER_INI_FACING   2       // Mirando a la derecha (direccion 1 << 1)
+
+#define FRAMES_PER_TICK     2
+
+#define MENU_KEY_KBD        0x4608  // "T" teclado
+#define MENU_KEY_JOY        0x4420  // "K" joystick
+#define BORDER_COLOUR       0x54
+#define DEATH_FLASH
+
+// --------------------------------------------------------------------------
+// Marcador
+// --------------------------------------------------------------------------
+
+#define LIVES_INI           5
+#define LIVES_ZERO_ENDS
+#define LIVES_X             8
+#define LIVES_Y             3
+#define RESPAWN_AT_ROOM_ENTRY
+
+#define TIMER_DOWN                  // BASIC 370: 999, baja 1 cada 12 vueltas
+#define TIME_INI            999
+#define TIME_DIGITS         3
+#define TIME_TICKS          15
+#define TIME_X              28
+#define TIME_Y              2
+
+// --------------------------------------------------------------------------
+// Reglas
+// --------------------------------------------------------------------------
+
+#define ENABLE_WANDERER
+#define WANDERER_SPAWN_ON_ENTER     // BASIC 1220
+#define WANDERER_EVERY      2
+#define WANDERER_KINDS      3
+#define WANDERER_FRAME(k)   (8 + ((k) << 1))
+#define WANDERER_PUFF_FRAME 8
+#define WANDERER_BLOCK_MASK 2
+#define WANDERER_AI_BABALIBA        // BASIC 1000-1060, igual que Babaliba
+
+#define ENABLE_SHOTS                // Biberones (BASIC 450-600, en asm)
+#define SHOTS_INI           15
+#define SHOT_SPEED          3
+#define SHOT_FRAME(d)       (14 + (d))
+#define SHOTS_X             17
+#define SHOTS_Y             3
