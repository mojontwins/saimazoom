+; Babaliba - como construir sus recursos (lo lee dev/build.py)
+; Graficos y mapa generados con utils/zx2cpc/babaliba.py a partir del
+; snapshot original, para retocarlos a mano.
+
+[game]
+gfx     = gfx
+map     = map
+palette = palette.png
+output  = babaliba
+
+[assets]
+numbers = chars in=font.png max=10
+tileset = dynamic in=tiles.png metatiles=metatiles.txt
+sprites = sprites in=sprites.png size=10,3 max=22 metasize=3,3
+marco   = superbuffer in=marcador.png
+title   = superbuffer in=menu.png
+map     = packed in=mapa.map map_w=15 map_h=9 room_w=10 room_h=5
+patrols = patrols in=patrols.txt
