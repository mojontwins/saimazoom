diff --git a/games/saimazoom/config.h b/games/saimazoom/config.h
new file mode 100644
index 0000000..0378572
--- /dev/null
+++ b/games/saimazoom/config.h
@@ -0,0 +1,103 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Configuracion del motor para Saimazoom (Dinamic, 1984).
+// Ver doc/motor.md para la lista completa de opciones.
+
+// --------------------------------------------------------------------------
+// Geometria
+// --------------------------------------------------------------------------
+
+#define ROOM_W              8       // Metatiles (3x3 celdas) por fila de pantalla
+#define ROOM_H              7       // Filas de metatiles
+#define ROOM_X              0       // Celda donde empieza el area de juego
+#define ROOM_Y              0
+#define MAP_W               10      // Pantallas por fila del mapa
+#define MAP_ROOMS           100
+
+#define MAP_RAW                     // Mapa sin comprimir (ROOM_W*ROOM_H bytes por pantalla)
+#define TILESET_STATIC              // Tileset fijo con metatiles 3x3 (tsmaps)
+
+#define SPRITES_N           2       // Jugador + monstruo errante
+#define SPRITE_OFF_X        24      // Donde se "aparca" un sprite apagado (fuera del area)
+#define SPRITE_OFF_Y        0
+
+// --------------------------------------------------------------------------
+// Inicio y ritmo
+// --------------------------------------------------------------------------
+
+#define SCR_INI             90
+#define PLAYER_INI_X        2
+#define PLAYER_INI_Y        4
+#define PLAYER_INI_FACING   2       // direccion << 1 (0 arriba, 2 dcha, 4 abajo, 6 izda)
+
+#define FRAMES_PER_TICK     4       // 12.5 Hz: una vuelta = un tick del original
+
+#define MENU_KEY_KBD        0x4801  // "1" teclado
+#define MENU_KEY_JOY        0x4802  // "2" joystick
+
+// --------------------------------------------------------------------------
+// Marcador
+// --------------------------------------------------------------------------
+
+#define LIVES_INI           3
+#define LIVES_X             29
+#define LIVES_Y             2
+
+#define ENABLE_SCORE
+#define SCORE_X             26
+#define SCORE_Y             6
+
+#define TIMER_UP                    // El tiempo sube; con 9999 se acaba la partida
+#define TIME_X              26
+#define TIME_Y              9
+
+#define ENABLE_WATER                // Agua: baja cada tick, a 0 pierdes una vida
+#define WATER_X             26
+#define WATER_Y             12
+#define WATER_PER_TICK      7
+
+// --------------------------------------------------------------------------
+// Reglas
+// --------------------------------------------------------------------------
+
+#define ENABLE_OBJECTS              // Objetos repartidos al azar + inventario ciclico
+#define ENABLE_TOOLS                // Barca / sable / pico para pasar rio / planta / roca
+#define ENABLE_CAVE_DOORS           // Cerrojos que teletransportan si llevas la llave
+
+#define ENABLE_WANDERER             // Monstruo que aparece al azar y persigue
+#define WANDERER_SPAWN_CHANCE 8     // rand () < n por tick con el monstruo apagado
+#define WANDERER_APPEAR_TICKS 8     // Ticks de "puff" al aparecer
+#define WANDERER_PUFF_FRAME   8
+#define WANDERER_FRAME(k)     (10 + ((k) << 1))
+#define WANDERER_KINDS_SAIMAZOOM    // etype = 1..4 como el original
+#define WANDERER_BLOCK_MASK   8
+#define WANDERER_AI_SAIMAZOOM       // 30% persigue, 34% al azar, 36% quieto
+#define WANDERER_PISTOL             // Se le mata llevando la pistola
+
+#define GAME_CHECK_WIN              // check_win () en game.h
+
+// --------------------------------------------------------------------------
+// Objetos (game.h)
+// --------------------------------------------------------------------------
+
+#define OBJ_SACK            20
+#define OBJ_PISTOL          21
+#define OBJ_KEY             22
+#define OBJ_BOAT            23
+#define OBJ_PICKAXE         24
+#define OBJ_SABER           25
+#define OBJ_WATER           26
+#define OBJ_EMPTY           27
+#define OBJ_NONE            0xff    // Objeto consumido (agua bebida): la casilla queda libre
+
+#define MAX_SACKS           4
+#define MAX_KEYS            2
+#define MAX_WATERS          12
+#define MAX_BOATS           8
+#define MAX_SABERS          5
+#define MAX_PICKAXES        5
+#define MAX_PISTOLS         10
+
+#define MAX_OBJECTS         MAX_SACKS + MAX_KEYS + MAX_WATERS + MAX_BOATS + MAX_SABERS + MAX_PICKAXES + MAX_PISTOLS
+#define MAX_PERSISTENT      MAX_SABERS + MAX_PICKAXES
diff --git a/games/saimazoom/data.h b/games/saimazoom/data.h
new file mode 100644
index 0000000..c68b5e2
--- /dev/null
+++ b/games/saimazoom/data.h
@@ -0,0 +1,30 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Datos propios de Saimazoom (tablas). El codigo esta en game.h
+// Referencias "BASIC nnnn" = lineas del listado decompilado del original.
+
+// Comportamiento de cada tile del mapa:
+// 8 obstaculo, 1 rio, 2 planta, 4 roca, 16 cerrojo, 32 objeto
+
+unsigned char tile_behs [] = {
+	 0, 10,  8,  8, 24,  8,  9,  9,  9,  9,
+	 9,  9, 10, 10, 10, 10,  8, 12,  8, 10
+};
+
+// Cuevas: aqui no se ponen llaves, y aqui va uno de los sacos
+unsigned char cave_room_numbers [] = { 38, 39, 48, 49 };
+#define IS_CAVE_ROOM(n) ((n) == 38 || (n) == 39 || (n) == 48 || (n) == 49)
+
+// BASIC 1130-1220: las puertas de las cuevas no se abren, te teletransportan.
+// Hace falta la llave (no se gasta). Numeracion de salas del port.
+// sala origen, sala destino, x, y de llegada (en tiles). Las entradas van por
+// parejas (i, i^1) para saber cual es la puerta de vuelta.
+#define N_DOORS 8
+unsigned char doors [] = {
+	15, 39, 5, 3, 		39, 15, 4, 5,
+	26, 49, 1, 3, 		49, 26, 4, 5,
+	98, 38, 4, 1, 		38, 98, 2, 0,
+	99, 48, 4, 5, 		48, 99, 5, 5
+};
+
diff --git a/games/saimazoom/game.h b/games/saimazoom/game.h
new file mode 100644
index 0000000..6a6f5cd
--- /dev/null
+++ b/games/saimazoom/game.h
@@ -0,0 +1,14 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Reglas propias de Saimazoom. Los datos estan en data.h
+
+// BASIC 120: gana si lleva 4 sacos de cafe (los 4 huecos del inventario)
+// y esta de vuelta en la casilla de salida.
+void check_win (void) {
+	if (n_pant == SCR_INI && ptx == PLAYER_INI_X && pty == PLAYER_INI_Y && pstate == STATE_IDLE &&
+		inventory [0] == OBJ_SACK && inventory [1] == OBJ_SACK &&
+		inventory [2] == OBJ_SACK && inventory [3] == OBJ_SACK) {
+		game_result = RESULT_WIN; playing = 0;
+	}
+}
diff --git a/games/saimazoom/game.ini b/games/saimazoom/game.ini
new file mode 100644
index 0000000..7135390
--- /dev/null
+++ b/games/saimazoom/game.ini
@@ -0,0 +1,18 @@
+; Saimazoom - como construir sus recursos (lo lee dev/build.py)
+; Las rutas de gfx y map son relativas a esta carpeta: Saimazoom sigue usando
+; las carpetas gfx/ y map/ de la raiz del repositorio.
+
+[game]
+gfx     = ../../gfx
+map     = ../../map
+palette = paleta-game.png
+output  = saimazoom
+
+[assets]
+; nombre = modo parametros (ver dev/build.py). Se ejecutan en orden.
+numbers = chars in=sprites.png offset=0,15 max=10
+tileset = mapped in=sprites.png offset=0,6 size=10,3 metasize=3,3 tmapoffs=10
+sprites = sprites in=sprites.png offset=0,0 size=10,2 max=20 metasize=3,3
+marco   = superbuffer in=marcador.png
+title   = superbuffer in=menu.png
+map     = raw in=mapa.map map_w=10 map_h=10 room_w=8 room_h=7
