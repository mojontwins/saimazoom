--- /dev/null
+++ b/dev/build.bat
@@ -0,0 +1,8 @@
+@echo off
+rem Construye un juego: build.bat [saimazoom|babaliba|alibebe]
+rem Necesita Python 3 con Pillow, zcc (z88dk) en el PATH y la cpcrslib
+rem recompilada (lib\cpcrslib\make.bat) tras los cambios de viewport_x2/y2.
+
+set GAME=%1
+if "%GAME%"=="" set GAME=saimazoom
+python build.py %GAME%
diff --git a/dev/build.py b/dev/build.py
new file mode 100644
index 0000000..56e2402
--- /dev/null
+++ b/dev/build.py
@@ -0,0 +1,236 @@
+#!/usr/bin/env python3
+# build.py - construye un juego del motor Saimazoom CPC.
+# Copyleft 2023 by The Mojon Twins
+#
+# Uso (desde dev/):   python build.py <juego> [--no-compile]
+#
+# Cada juego vive en ../games/<juego>/ con:
+#   config.h   #defines que configuran el motor (tamano del area, reglas...)
+#   game.h     datos y codigo propios del juego (tablas, ganchos)
+#   game.ini   de que carpetas sacar graficos y mapa y como convertirlos
+#
+# Lo generado va a ../games/<juego>/build/ (assets/*.h y bin/*.bin), y el
+# resultado a dev/<juego>.bin y dev/<juego>.sna.
+#
+# Necesita Python 3 + Pillow, zx0 (utils/zx0.exe en Windows o zx0 en el PATH)
+# y z88dk con zcc en el PATH.
+
+import sys, os, subprocess, configparser, shutil, struct
+
+HERE = os.path.dirname (os.path.abspath (__file__))
+ROOT = os.path.dirname (HERE)
+sys.path.insert (0, os.path.join (ROOT, "utils"))
+import mkassets as mk
+
+def die (msg): sys.exit ("build: " + msg)
+
+def rel (p):
+	# Ruta relativa a dev/ con barras normales (la usan BINARY de z80asm)
+	return os.path.relpath (p, HERE).replace ("\\", "/")
+
+def zx0 (src, dst):
+	exe = None
+	for c in (os.path.join (ROOT, "utils", "zx0.exe") if os.name == "nt" else None, shutil.which ("zx0")):
+		if c and os.path.exists (c): exe = c; break
+	if not exe: die ("no encuentro el compresor zx0")
+	if os.path.exists (dst): os.remove (dst)
+	subprocess.run ([exe, "-f", src, dst], check = True, stdout = subprocess.DEVNULL)
+	return open (dst, "rb").read ()
+
+def zx0_bytes (data, tmp):
+	open (tmp, "wb").write (data)
+	return zx0 (tmp, tmp + ".zx0")
+
+def args (s):
+	d = {}
+	for t in s.split ():
+		if "=" in t:
+			k, v = t.split ("=", 1); d [k] = v
+		else: d [t] = "1"
+	return d
+
+def xy (s, default = None):
+	if not s: return default
+	a, b = s.split (","); return int (a), int (b)
+
+# Cabecera de snapshot (la que genera cpctbin2sna); se parchea PC
+SNA_HEADER = bytes.fromhex (
+	"")
+
+def make_sna (binf, org, out):
+	data = open (binf, "rb").read ()
+	hdr = bytearray (SNA_HEADER); mem = bytearray (65536)
+	mem [org:org + len (data)] = data
+	hdr [0x23] = org & 0xff; hdr [0x24] = org >> 8
+	open (out, "wb").write (bytes (hdr) + bytes (mem))
+
+class Builder:
+	def __init__ (self, game):
+		self.game = game
+		self.gdir = os.path.join (ROOT, "games", game)
+		ini = os.path.join (self.gdir, "game.ini")
+		if not os.path.exists (ini): die ("no existe " + ini)
+		self.cfg = configparser.ConfigParser (inline_comment_prefixes = (";", "#"))
+		self.cfg.optionxform = str
+		self.cfg.read (ini)
+		g = self.cfg ["game"]
+		self.gfx = os.path.normpath (os.path.join (self.gdir, g.get ("gfx", "gfx")))
+		self.map = os.path.normpath (os.path.join (self.gdir, g.get ("map", "map")))
+		self.out = g.get ("output", game)
+		self.org = int (g.get ("org", "0x400"), 0)
+		self.bdir = os.path.join (self.gdir, "build")
+		self.bin = os.path.join (self.bdir, "bin")
+		self.assets = os.path.join (self.bdir, "assets")
+		os.makedirs (self.bin, exist_ok = True)
+		os.makedirs (self.assets, exist_ok = True)
+		self.pal = mk.Palette (os.path.join (self.gfx, g.get ("palette", "palette.png")))
+
+	def g (self, f): return os.path.join (self.gfx, f)
+	def m (self, f): return os.path.join (self.map, f)
+	def b (self, f): return os.path.join (self.bin, f)
+	def h (self, name, text):
+		mk.write (os.path.join (self.assets, name), "// Generado por build.py - no editar\n\n" + text)
+
+	def img (self, f): return mk.PenImage (self.g (f), self.pal)
+
+	# ------------------------------------------------------------------
+
+	def run (self):
+		a = self.cfg ["assets"]
+		self.h ("pal.h", mk.pals (self.pal, "my_inks"))
+		for key in a:
+			kind, *rest = a [key].split (None, 1)
+			p = args (rest [0] if rest else "")
+			getattr (self, "do_" + kind) (key, p)
+		print ("build: assets de %s generados en %s" % (self.game, rel (self.bdir)))
+
+	def do_chars (self, key, p):
+		# Patrones sueltos (digitos del marcador). Van al principio del tileset.
+		data = mk.chars (self.img (p ["in"]), xy (p.get ("offset"), (0, 0)), xy (p.get ("size")), int (p.get ("max", "-1")), True)
+		mk.write (self.b (key + ".bin"), data)
+		self.numbers = key
+
+	def do_mapped (self, key, p):
+		# Tileset estatico (Saimazoom): metatiles 3x3 deduplicados
+		ts, tm = mk.mapped (self.img (p ["in"]), xy (p.get ("offset"), (0, 0)), xy (p.get ("size")),
+			xy (p.get ("metasize"), (3, 3)), -1, int (p.get ("tmapoffs", "0")), True)
+		mk.write (self.b ("ts.bin"), ts); mk.write (self.b ("tsmaps.bin"), tm)
+		self.h ("ts.h",
+			"extern unsigned char tileset [0];\nextern unsigned char tsmaps [0];\n\n#asm\n"
+			"\t\tXDEF _ts\n\t\tXDEF tiles\n\t._tileset\n\t.tiles\n"
+			"\t\tBINARY \"%s\"\n\t\tBINARY \"%s\"\n\n\t._tmaps\n\t\tBINARY \"%s\"\n#endasm\n" %
+			(rel (self.b (self.numbers + ".bin")), rel (self.b ("ts.bin")), rel (self.b ("tsmaps.bin"))))
+
+	def do_dynamic (self, key, p):
+		# Tileset dinamico: graficos base comprimidos + metatiles = base + recoloreo
+		img = self.img (p ["in"])
+		mts = mk.parse_metatiles (self.g (p ["metatiles"]))
+		nbases = max (m [0] for m in mts if m) + 1
+		bases = mk.base_tiles (img, nbases)
+		comp = []; offs = []; pos = 0
+		for i, b in enumerate (bases):
+			c = zx0_bytes (mk.grey_order (b"".join (b)), self.b ("tmp_base"))
+			offs.append (pos); comp.append (c); pos += len (c)
+		mk.write (self.b ("tsbase.bin"), b"".join (comp))
+		for f in ("tmp_base", "tmp_base.zx0"):
+			if os.path.exists (self.b (f)): os.remove (self.b (f))
+		remaps = []; mt_base = []; mt_remap = []; behs = []; names = []
+		for i, m in enumerate (mts):
+			base, remap, beh = m if m else (0, list (range (16)), 0)
+			if remap == list (range (16)): ri = 0xff
+			else:
+				if remap not in remaps: remaps.append (remap)
+				ri = remaps.index (remap)
+			mt_base.append (base); mt_remap.append (ri); behs.append (beh)
+		for line in open (self.g (p ["metatiles"])):
+			line = line.split ("#") [0]
+			for t in line.split ():
+				if t.startswith ("name="): names.append ((t [5:], int (line.split () [0])))
+		t  = "// Tileset dinamico: %d metatiles, %d graficos base (%d bytes comprimidos)\n\n" % (len (mts), nbases, pos)
+		t += "#define N_METATILES %d\n#define N_BASES %d\n\n" % (len (mts), nbases)
+		for n, i in names: t += "#define MT_%s %d\n" % (n, i)
+		t += "\nextern unsigned char tileset [0];\nextern unsigned char ts_base_data [0];\n#asm\n\t\tXDEF tiles\n\t._tileset\n\t.tiles\n"
+		t += "\t\tBINARY \"%s\"\n" % rel (self.b (self.numbers + ".bin"))
+		t += "\t\tdefs 16\t\t\t\t// patron 10: vacio\n"
+		t += "\t\tdefs DYN_SLOTS * 9 * 16\t// zona dinamica\n"
+		t += "\t._ts_base_data\n\t\tBINARY \"%s\"\n#endasm\n\n" % rel (self.b ("tsbase.bin"))
+		t += "unsigned int ts_base_offs [] = { " + ", ".join (str (o) for o in offs) + " };\n\n"
+		t += mk.c_array ("mt_base", bytes (mt_base))
+		t += mk.c_array ("mt_remap", bytes (mt_remap))
+		t += mk.c_array ("mt_remaps", bytes (sum (remaps, [])) or b"\0")
+		t += mk.c_array ("tile_behs", bytes (behs))
+		self.h ("ts.h", t)
+
+	def do_sprites (self, key, p):
+		data, n = mk.sprites (self.img (p ["in"]), xy (p.get ("offset"), (0, 0)), xy (p.get ("size")),
+			xy (p.get ("metasize"), (3, 3)), int (p.get ("max", "-1")))
+		mk.write (self.b ("ss.bin"), data)
+		self.h ("ss.h", "extern unsigned char sprites [0];\n#asm\n\t._sprites\n\t\tBINARY \"%s\"\n#endasm\n" % rel (self.b ("ss.bin")))
+		self.h ("ssmaps.h", mk.sprite_mappings (n, xy (p.get ("metasize"), (3, 3))))
+
+	def do_superbuffer (self, key, p):
+		mk.write (self.b (key + ".bin"), mk.superbuffer (self.img (p ["in"])))
+		zx0 (self.b (key + ".bin"), self.b (key + "c.bin"))
+		self.bitmaps = getattr (self, "bitmaps", "") + "\t.s_%s\n\t\tBINARY \"%s\"\n\n" % (key, rel (self.b (key + "c.bin")))
+		self.h ("bitmaps.h", "// Pantallas completas comprimidas\n\n#asm\n" + self.bitmaps + "#endasm\n")
+
+	def do_raw (self, key, p):
+		# Mapa sin comprimir: ROOM_W * ROOM_H bytes por pantalla
+		data = mk.mapcnv (self.m (p ["in"]), int (p ["map_w"]), int (p ["map_h"]), int (p ["room_w"]), int (p ["room_h"]))
+		self.h ("mapa.h", mk.c_array ("mapa", data))
+
+	def do_packed (self, key, p):
+		# Mapa con cada pantalla comprimida con zx0 por separado
+		rw, rh = int (p ["room_w"]), int (p ["room_h"])
+		data = mk.mapcnv (self.m (p ["in"]), int (p ["map_w"]), int (p ["map_h"]), rw, rh)
+		n = int (p.get ("rooms", len (data) // (rw * rh)))
+		out = bytearray (); offs = []
+		for r in range (n):
+			offs.append (len (out))
+			out += zx0_bytes (data [r * rw * rh:(r + 1) * rw * rh], self.b ("tmp_room"))
+		for f in ("tmp_room", "tmp_room.zx0"):
+			if os.path.exists (self.b (f)): os.remove (self.b (f))
+		mk.write (self.b ("mapa.bin"), bytes (out))
+		t  = "// Mapa: %d pantallas comprimidas por separado (%d bytes)\n\n" % (n, len (out))
+		t += "extern unsigned char mapa [0];\n#asm\n\t._mapa\n\t\tBINARY \"%s\"\n#endasm\n\n" % rel (self.b ("mapa.bin"))
+		t += "unsigned int mapa_offs [] = {\n"
+		for i in range (0, n, 12):
+			t += "\t" + ", ".join (str (o) for o in offs [i:i+12]) + (",\n" if i + 12 < n else "\n")
+		t += "};\n"
+		self.h ("mapa.h", t)
+
+	def do_patrols (self, key, p):
+		# Patrulleros: una entrada por pantalla que tenga
+		rows = []
+		for line in open (self.m (p ["in"])):
+			line = line.split ("#") [0].split ()
+			if len (line) == 6: rows.append ([int (x) for x in line])
+		data = bytearray ()
+		for r in rows: data += bytes (r)
+		t  = "// Patrulleros: sala, tipo, x, y, min, max (%d)\n\n#define N_PATROLS %d\n\n" % (len (rows), len (rows))
+		t += mk.c_array ("patrols", bytes (data) or b"\xff", 6)
+		self.h ("patrols.h", t)
+
+	# ------------------------------------------------------------------
+
+	def compile (self):
+		zcc = shutil.which ("zcc")
+		if not zcc: die ("no encuentro zcc (z88dk) en el PATH")
+		binf = self.out + ".bin"
+		cmd = [zcc, "+cpc", "-m", "-vn", "-unsigned", "-zorg=%d" % self.org, "-lcpcrslib",
+			"-I" + rel (self.gdir), "-I" + rel (self.bdir),
+			"-o", binf, "system/tilemap_conf.asm", "saimazoom.c"]
+		r = subprocess.run (cmd, cwd = HERE)
+		if r.returncode: die ("error compilando")
+		size = os.path.getsize (os.path.join (HERE, binf))
+		end = self.org + size
+		print ("build: %s %d bytes (0x%04X-0x%04X), libres hasta 0x8800: %d" % (binf, size, self.org, end - 1, 0x8800 - end))
+		if end > 0x8800: print ("build: OJO! el binario pisa el buffer de musica (0x8800)")
+		make_sna (os.path.join (HERE, binf), self.org, os.path.join (HERE, self.out + ".sna"))
+		print ("build: %s.sna listo" % self.out)
+
+if __name__ == "__main__":
+	if len (sys.argv) < 2: die ("uso: python build.py <juego> [--no-compile]   (juegos en ../games)")
+	b = Builder (sys.argv [1])
+	b.run ()
+	if "--no-compile" not in sys.argv: b.compile ()
diff --git a/dev/cavedoors.h b/dev/cavedoors.h
new file mode 100644
index 0000000..670196e
--- /dev/null
+++ b/dev/cavedoors.h
@@ -0,0 +1,29 @@
+// Saimazoom CPC
+// Copyleft 2023 by The Mojon Twins
+
+// Puertas que teletransportan (ENABLE_CAVE_DOORS). Saimazoom BASIC 1130-1220:
+// las puertas de las cuevas no se abren, te llevan a otra sala si llevas la
+// llave (no se gasta). Tabla doors [] en data.h: sala origen, sala destino,
+// x, y de llegada (tiles), por parejas (i, i^1) ida y vuelta.
+
+unsigned char door_visited;
+
+void cave_door (void) {
+	for (gpit = 0; gpit < N_DOORS; gpit ++) {
+		gp_gen = doors + (gpit << 2);
+		if (gp_gen [0] == n_pant) {
+			// +500 si la sala de la que sales no ha sido marcada; se marca
+			// la de llegada (BASIC 1210-1220). score_add usa gpit: guardamos antes.
+			rdc = 1 << gpit;
+			rdm = 1 << (gpit ^ 1);
+			if ((door_visited & rdc) == 0) SCORE_ADD (500);
+			door_visited |= rdm;
+
+			n_pant = gp_gen [1];
+			ptx = gp_gen [2]; pty = gp_gen [3];
+			px = (ptx << 1) + ptx; py = (pty << 1) + pty;
+			pstate = STATE_IDLE;
+			return;
+		}
+	}
+}
